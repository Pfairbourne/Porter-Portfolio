{
	"version": 3,
	"routes": [
		{
			"src": "^/(.*)/$",
			"headers": {
				"Location": "/$1"
			},
			"status": 308
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)$",
			"dest": "_render"
		},
		{
			"src": "^/_image$",
			"dest": "_render"
		},
		{
			"src": "^/api/admin/login$",
			"dest": "_render"
		},
		{
			"src": "^/api/admin/logout$",
			"dest": "_render"
		},
		{
			"src": "^/api/admin/menubar-status$",
			"dest": "_render"
		},
		{
			"src": "^/api/admin/visibility$",
			"dest": "_render"
		},
		{
			"src": "^/api/notepad$",
			"dest": "_render"
		},
		{
			"src": "^/settings/login$",
			"dest": "_render"
		},
		{
			"src": "^/settings/menubar$",
			"dest": "_render"
		},
		{
			"src": "^/settings/visibility$",
			"dest": "_render"
		},
		{
			"src": "^/settings$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "/404.html",
			"status": 404
		}
	]
}