---
import WindowLayout from '../../layouts/WindowLayout.astro';

export const prerender = false;

const errored = Astro.url.searchParams.get('error') === '1';
const next = Astro.url.searchParams.get('next') ?? '/settings';
---
<WindowLayout
  title="Login — Porter Fairbourne"
  description="Admin login."
  windowTitle="login.app"
  narrow
>
  <div class="login">
    <div class="t-label" style="margin-bottom: var(--s-4);">Sign in</div>
    <h1 class="t-h1">Welcome back<span class="accent">.</span></h1>
    <p class="t-italic-serif" style="margin-top: var(--s-3); margin-bottom: var(--s-6);">
      Admin access for editing the portfolio.
    </p>

    <form action="/api/admin/login" method="POST" class="login__form">
      <input type="hidden" name="next" value={next} />
      <label class="login__label">
        <span class="t-label">Password</span>
        <input
          type="password"
          name="password"
          required
          autocomplete="current-password"
          autofocus
          class="login__input"
        />
      </label>
      {errored && (
        <p class="login__error" role="alert">
          Wrong password — or too many tries. Wait 15 minutes and try again.
        </p>
      )}
      <button type="submit" class="btn btn-solid login__submit">Sign in</button>
    </form>
  </div>
</WindowLayout>

<style>
  .login { max-width: 420px; }
  .login__form {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    margin-top: var(--s-5);
  }
  .login__label {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .login__input {
    padding: 10px 14px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    background: var(--bg-elev);
    color: var(--ink);
    font: inherit;
    transition: border-color 160ms ease;
  }
  .login__input:focus {
    outline: none;
    border-color: var(--ink-2);
  }
  .login__error {
    color: var(--accent);
    font-size: 13.5px;
    margin: 0;
  }
  .login__submit { align-self: flex-start; cursor: pointer; }
</style>
