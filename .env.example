# Copy to .env (locally) and set the same values in Vercel project env (production).
# Locally, anything left blank degrades gracefully (KV reads fall back to defaults,
# rate limits become no-ops). In production, ADMIN_PASSWORD_HASH + SESSION_SECRET
# are required for the CMS to work.

# ─── Auth ─────────────────────────────────────
# Bcrypt hash of the admin password. Generate locally:
#   node -e "console.log(require('bcryptjs').hashSync('your-password-here', 12))"
ADMIN_PASSWORD_HASH=

# 32+ random bytes. Generate locally:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ─── Upstash Redis (KV) ──────────────────────
# Sign up at https://upstash.com, create a Redis DB, copy REST URL + REST token.
# Used for instant icon visibility, menu-bar status, and login rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── GitHub (CMS content persistence) ────────
# Fine-grained PAT with Contents: Read/Write on this repo only.
# Settings forms commit to this repo, which triggers a Vercel rebuild.
GITHUB_TOKEN=
GITHUB_REPO=porterfairbourne/porter-portfolio
GITHUB_BRANCH=main

# ─── Cal.com (Calendar embed) ────────────────
CAL_USERNAME=porterfairbourne
CAL_EVENT_SLUG=20min

# ─── Anthropic (Ask-about-this-site chatbot) ─
# Powers the /ask chat window (Help → Ask about this site).
# Create a key at https://console.anthropic.com. Without it, the chat degrades
# to a friendly "not connected yet" message. Set the same value in Vercel env.
ANTHROPIC_API_KEY=

# ─── Voice Tour (ElevenLabs Conversational AI agent) ─
# The desktop tour can hand off to a live voice guide (a clone of Porter's voice).
# Both are server-side only: a server route mints a short-lived signed URL, so no
# secret (and not even the agent id) is shipped to the client. Without them, the
# tour falls back to the scripted narration + captions and never dead-ends.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
