# Copy to .env (locally) and set the same values in Vercel project env (production).
# Locally, anything left blank degrades gracefully (KV reads fall back to defaults,
# rate limits become no-ops). In production, ADMIN_PASSWORD_HASH + SESSION_SECRET
# are required for the CMS to work.

# ─── Auth ─────────────────────────────────────
# Bcrypt hash of the admin password. Generate locally:
#   node -e "console.log(require('bcryptjs').hashSync('your-password-here', 12))"
ADMIN_PASSWORD_HASH=

# 32+ random bytes. Generate locally:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ─── Upstash Redis (KV) ──────────────────────
# Sign up at https://upstash.com, create a Redis DB, copy REST URL + REST token.
# Used for instant icon visibility, menu-bar status, and login rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── GitHub (CMS content persistence) ────────
# Fine-grained PAT with Contents: Read/Write on this repo only.
# Settings forms commit to this repo, which triggers a Vercel rebuild.
GITHUB_TOKEN=
GITHUB_REPO=porterfairbourne/porter-portfolio
GITHUB_BRANCH=main

# ─── Resend (Notepad email) ──────────────────
# https://resend.com — verify porterfairbourne.com for the "from" address.
RESEND_API_KEY=
RESEND_FROM=Porter <porter@porterfairbourne.com>
RESEND_TO=pfairbourne@gmail.com

# ─── Cal.com (Calendar embed) ────────────────
CAL_USERNAME=porterfairbourne
CAL_EVENT_SLUG=20min
