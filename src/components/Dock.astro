---
import DockIcon from './DockIcon.astro';
import PhotosGlyph from './dock-glyphs/PhotosGlyph.astro';
import NotepadGlyph from './dock-glyphs/NotepadGlyph.astro';
import BooksGlyph from './dock-glyphs/BooksGlyph.astro';
import MusicGlyph from './dock-glyphs/MusicGlyph.astro';
import CalendarGlyph from './dock-glyphs/CalendarGlyph.astro';
import SettingsGlyph from './dock-glyphs/SettingsGlyph.astro';
import type { VisibilityMap } from '../lib/kv';

interface Props {
  visibility?: VisibilityMap;
}

const { visibility = {} } = Astro.props;

const showIf = (id: string) => visibility[id] !== false;

type DockApp = { id: string; href: string; label: string; Glyph: typeof PhotosGlyph };
const apps: DockApp[] = [
  { id: 'photos',   href: '/photos',   label: 'Photos',   Glyph: PhotosGlyph },
  { id: 'notepad',  href: '/notepad',  label: 'Notepad',  Glyph: NotepadGlyph },
  { id: 'books',    href: '/books',    label: 'Books',    Glyph: BooksGlyph },
  { id: 'music',    href: '/music',    label: 'Music',    Glyph: MusicGlyph },
  { id: 'calendar', href: '/calendar', label: 'Calendar', Glyph: CalendarGlyph },
  { id: 'settings', href: '/settings', label: 'Settings', Glyph: SettingsGlyph },
];
---
<nav class="dock" aria-label="Apps">
  {apps.filter((a) => showIf(a.id)).map(({ id, href, label, Glyph }) => (
    <DockIcon id={id} href={href} label={label}>
      <Glyph />
    </DockIcon>
  ))}
</nav>

<script is:inline>
  (function () {
    var dock = document.querySelector('.dock');
    if (!dock) return;
    var icons = Array.prototype.slice.call(dock.querySelectorAll('.dock__icon'));
    if (!icons.length) return;

    function focusAt(index) {
      var clamped = Math.max(0, Math.min(icons.length - 1, index));
      icons[clamped].focus();
    }

    dock.addEventListener('keydown', function (e) {
      var current = icons.indexOf(document.activeElement);
      if (current < 0) return;
      if (e.key === 'ArrowRight') { e.preventDefault(); focusAt(current + 1); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); focusAt(current - 1); }
      else if (e.key === 'Home') { e.preventDefault(); focusAt(0); }
      else if (e.key === 'End') { e.preventDefault(); focusAt(icons.length - 1); }
    });
  })();
</script>
