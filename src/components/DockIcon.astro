---
interface Props {
  id: string;
  href: string;
  label: string;
  external?: boolean;
}
const { id, href, label, external = false } = Astro.props;
---
<a
  class="dock__icon"
  href={href}
  aria-label={label}
  data-dock-icon-id={id}
  draggable="false"
  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
  <span class="dock__tile">
    <slot />
  </span>
  <span class="dock__tooltip" aria-hidden="true">{label}</span>
  <span class="dock__caption" aria-hidden="true">{label}</span>
</a>
