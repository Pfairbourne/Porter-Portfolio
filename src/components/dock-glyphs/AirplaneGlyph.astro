---
/**
 * AirplaneGlyph — dock icon for the "Favorite quote" feature. A paper airplane
 * authored in the same 32×32 viewBox + stroke conventions as the other dock
 * glyphs (dg-stroke outline, dg-line center crease); hover recolors to accent
 * for free via the shared .dock__icon:hover rules in global.css.
 */
---
<svg viewBox="0 0 32 32" class="dock-glyph" aria-hidden="true">
  <!-- upper face -->
  <path d="M 29 4 L 3 13 L 13 18 Z" class="dg-stroke" />
  <!-- lower face / keel -->
  <path d="M 29 4 L 13 18 L 16 28 Z" class="dg-stroke" />
  <!-- center crease -->
  <path d="M 29 4 L 13 18" class="dg-line" />
</svg>
