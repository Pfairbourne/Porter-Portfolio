---
/**
 * FileGlyph — desktop file icon with a vertical-gradient halftone.
 *
 * Dots run small/sparse at the top to large/overlapping at the bottom (linear
 * ramp), so the dense bottom band reads as the dark label area behind the
 * white extension text. The gradient is rasterised CLIENT-SIDE to a PNG and
 * dropped into the empty <image data-ht="file"> placeholder below — see
 * src/lib/halftone-raster.ts + the client script in DesktopIcon.astro.
 *
 * Server-rendered immediately: paper body, corner fold, outline, extension
 * label. The dot <image> fills in within a frame once JS runs.
 */
interface Props {
  ext?: string;
  /** Per-instance clipPath id suffix (required — multiple files share this component). */
  uid: string;
}

const { ext = '', uid } = Astro.props;

const W = 72;
const H = 72;

// File body: 56×64 at (8, 4), top-right corner cut with 14px diagonal fold.
const x0 = 8;
const y0 = 4;
const w = 56;
const h = 64;
const fold = 14;

const bodyPath = `M ${x0} ${y0 + 2} Q ${x0} ${y0}, ${x0 + 2} ${y0} L ${x0 + w - fold} ${y0} L ${x0 + w} ${y0 + fold} L ${x0 + w} ${y0 + h - 2} Q ${x0 + w} ${y0 + h}, ${x0 + w - 2} ${y0 + h} L ${x0 + 2} ${y0 + h} Q ${x0} ${y0 + h}, ${x0} ${y0 + h - 2} Z`;
const foldPath = `M ${x0 + w - fold} ${y0} L ${x0 + w - fold} ${y0 + fold} L ${x0 + w} ${y0 + fold}`;

const extY = y0 + h - 6;
const clipId = `clip-file-${uid}`;
---
<svg viewBox={`0 0 ${W} ${H}`} class="halftone-icon" aria-hidden="true">
  <defs>
    <clipPath id={clipId}>
      <path d={bodyPath} />
    </clipPath>
  </defs>
  <path d={bodyPath} class="icon-paper" />
  <g clip-path={`url(#${clipId})`}>
    {/* Halftone gradient PNG injected client-side. */}
    <image data-ht="file" x="0" y="0" width={W} height={H} />
  </g>
  <path d={foldPath} class="icon-fold" />
  <path d={bodyPath} class="icon-outline" />
  <text x={x0 + w / 2} y={extY} class="icon-label-text" text-anchor="middle">.{ext}</text>
</svg>
