---
import FileGlyph from './FileGlyph.astro';
import FolderGlyph from './FolderGlyph.astro';
import type { BrandName } from '../lib/brand-glyphs';

interface Props {
  /** Stable identifier used to persist drag positions in localStorage. */
  id: string;
  href: string;
  label: string;
  /** File extension shown inside the SVG label band (e.g. "md", "pdf"). Ignored for folders. */
  ext?: string;
  /** Visual style of the glyph. */
  variant?: 'file' | 'folder';
  /** Open the link in a new tab (sets target="_blank" + rel). */
  external?: boolean;
  /** Trigger a download instead of navigation. */
  download?: boolean;
  /** Optional brand glyph rendered inside a folder (e.g. 'robot' for ai-agents). Ignored for files. */
  brand?: BrandName;
}

const {
  id,
  href,
  label,
  ext = '',
  variant = 'file',
  external = false,
  download = false,
  brand,
} = Astro.props;

const rel = external ? 'noopener noreferrer' : undefined;
const target = external ? '_blank' : undefined;
const variantClass = variant === 'folder' ? 'icon--folder' : 'icon--file';
---
<a
  class:list={['icon', variantClass]}
  href={href}
  target={target}
  rel={rel}
  download={download ? '' : undefined}
  data-icon-id={id}
  draggable="false"
>
  <div class="icon__glyph">
    {variant === 'folder'
      ? <FolderGlyph uid={id} brand={brand} />
      : <FileGlyph uid={id} ext={ext} />}
  </div>
  <span class="icon__label">{label}</span>
</a>

<script>
  // Rasterise every desktop folder/file halftone (PNG) and drop it into the
  // <image> placeholders the glyph components emit. Bundled once by Astro
  // regardless of how many icons render. The folder/file bodies are already
  // server-rendered, so this only paints the dot field a frame later.
  import { fillHalftoneImages } from '../lib/halftone-raster';
  const run = () => fillHalftoneImages();
  if (document.readyState !== 'loading') run();
  else document.addEventListener('DOMContentLoaded', run);
</script>
