      openWindow: (p: { name?: string }) => {
        const key = (p?.name || '').trim().toLowerCase();
        const path = WINDOW_PATHS[key];
        if (path) { desktop()?.open(path); if (touring) repinOrb(); else pointAtWindow(); return `Opened ${key}.`; }
        return `There is no window called "${key}".`;
      },
      navigateTo: (p: { path?: string }) => {
        const path = (p?.path || '').trim();
        if (!path || path === '/') { desktop()?.close(); return 'Returned to the desktop.'; }
        const full = path.startsWith('/') ? path : '/' + path;
        desktop()?.open(full);
        if (touring) repinOrb(); else pointAtWindow();
        return `Opened ${path}.`;
      },
      highlightProject: (p: { id?: string }) => {
        const id = (p?.id || '').trim();
        desktop()?.open('/projects');
        window.setTimeout(() => highlightProjectCard(id), 650);
        return `Highlighting ${id}.`;
      },
      pointAt: (p: { id?: string; selector?: string; text?: string }) => {
        const el = resolvePointTarget(p || {});
        if (el) { cursorPointAt(el, 120); return 'Pointing at it.'; }
        return 'Could not find that on screen.';
      },
      resumeTour: () => {
        // Resume is visitor-driven (their voice/text "continue" cue, or the Resume button).
        // The agent should never call this; if a stale prompt does, no-op so the call can't
        // cut its own answer off by navigating the page mid-utterance.
        console.warn('[guide] agent called resumeTour; ignored (resume is visitor-driven)');
        return 'I cannot resume the tour. The visitor will say continue or click the Resume button when they are ready.';
      },
      startTour: () => {
        if (touring) return 'The tour is already running.';
        // Defer slightly so the agent's tool-return settles before we send the kickoff
        // directive, avoiding overlap with whatever it says about starting the tour.
        window.setTimeout(() => { if (!touring) takeTour(); }, 250);
        return 'Starting the tour now.';
      },
    };

    // ---- agent session ----
    async function connectGuide() {
      if (conversation || connecting || userPaused) return;   // never bring the agent up while paused
      if (connectDeferred) return;   // already waiting on the first real gesture (see the defer block below)
      if (isOverBudget()) {
        // Daily voice-guide budget exhausted for this browser; refuse to mint another
        // metered ElevenLabs session. Leave the panel up so the visitor sees why.
        if (panelOpen) { setState('off'); setMsg(BUDGET_OVER_MSG); }
        return;
      }
      // Don't open the metered ElevenLabs session until the visitor has actually interacted.
      // Browsers block audio without a user gesture (the agent would be silent and the SDK's
      // AudioContext logs a warning), and connecting on mouse movement alone (the auto-pop
      // below) burns the daily character budget on passersby who never engage. If there's been
      // no genuine activation yet, surface the panel but hold the connect until the first real
      // gesture, then connect. Gesture-initiated opens (orb/Take tour/mic/typed question) already
      // have activation, so they connect immediately. Browsers without the userActivation API
      // fall through and connect as before.
      const ua = (navigator as any).userActivation as { hasBeenActive?: boolean } | undefined;
      if (ua && ua.hasBeenActive === false) {
        connectDeferred = true;
        const onFirstGesture = () => {
          document.removeEventListener('pointerdown', onFirstGesture, true);
          document.removeEventListener('keydown', onFirstGesture, true);
          document.removeEventListener('touchend', onFirstGesture, true);
          connectDeferred = false;
          // Re-enter only if the guide is still open and idle. A gesture-initiated handler
          // (takeTour sets tourMode, a typed question sets pendingText) may run right after this
          // in the same gesture; onConnect honours those flags, so we don't get stuck in
          // exploring mode or double-connect.
          if (panelOpen && !conversation && !connecting && !userPaused) connectGuide();
        };
        document.addEventListener('pointerdown', onFirstGesture, true);
        document.addEventListener('keydown', onFirstGesture, true);
        document.addEventListener('touchend', onFirstGesture, true);
        return;
      }
      connecting = true;
      audioSeen = false; voiceWarned = false;
      unlockAudio();   // resume audio within the gesture, before we await the signed URL
      setState('connecting');
      try {
        const res = await fetch('/api/tour/agent-url');
        const data = (await res.json().catch(() => ({}))) as { ok?: boolean; signedUrl?: string; reason?: string; status?: number; detail?: string };
        if (!data.ok || !data.signedUrl) {
          connecting = false; pendingText = null;
          flagOffline('Guide offline', 'agent-url: ' + (data.reason || res.status) + (data.detail ? ' (' + data.detail + ')' : ''));
          bailTourOffline();
          return;
        }
        conversation = await Conversation.startSession({
          signedUrl: data.signedUrl,
          clientTools,
          // Inject the sales-guide brain from code. Requires "Overrides" enabled on the
          // agent's Security settings; if the agent rejects it the catch below reconnects
          // without overrides, so the guide still works (using its dashboard prompt).
          ...(allowOverrides ? { overrides: { agent: { prompt: { prompt: TOUR_GUIDE_PROMPT } } } } : {}),
          onConnect: () => {
            connecting = false; voiceEnabled = true;
            if (userPaused) return;   // paused mid-connect: the post-await guard tears it down
            // Push-to-talk: start muted so ambient noise doesn't trigger the agent. The
            // visitor taps the mic to talk; auto-mute kicks in after silence.
            micMuted = true; pttActive = false;
            try { conversation && conversation.setMicMuted(true); } catch (_) {}
            micBtn.classList.remove('is-recording');
            setState('muted');
            armIdle();
            try { conversation && conversation.setVolume({ volume: outputMuted ? 0 : 1 }); } catch (_) {}
            if (tourMode) {
              // Agent-led tour: the client now drives the page-by-page walkthrough,
              // starting with the desktop preamble and then opening /projects.
              tourMode = false;   // one-shot: only kick off on this connect, not on later reconnects
              startTourFlow();
            } else if (pendingText) {
              // flush a queued question now that the socket is open (typed before connect)
              try { conversation && conversation.sendUserMessage(pendingText); } catch (_) {} pendingText = null;
            } else if (exploring && !exploringGreeted) {
              // First connect of an exploring session: agent greets and offers the tour vocally.
              exploringGreeted = true;
              const opener = `Say ONE short greeting sentence and ask whether they would like a quick guided tour of Porter's work, or if they have a specific question. Then STOP and wait for their answer. Do NOT navigate anywhere. Do NOT call any tool yet. Do NOT start describing Porter or any page. Just greet and ask the choice. If they later accept the tour (yes, sure, please, take me through it, etc.), call the startTour tool. If they ask a question, answer it directly using your tools.`;
              lastDirective = opener; lastDirectiveAt = Date.now();
              try { conversation && conversation.sendUserMessage(opener); } catch (_) {}
            }
          },
          onModeChange: ({ mode }) => {
            if (userPaused) return;   // ignore agent activity while the visitor has it paused
            armIdle();
            if (mode === 'speaking') {
              // If the visitor spoke after our last scripted directive and the agent is now
              // replying, this is a Q&A turn — hold the tour even when no user transcript
              // arrives via onMessage (some agent configs skip user-side transcripts). Also
              // treat as Q&A if the agent starts speaking long after our directive landed,
              // since scripted speech normally starts within a few seconds of the directive.
              const recentUserSpeech = userSpokeAt > lastDirectiveAt && Date.now() - userSpokeAt < 8000;
              // Only treat a late agent reply as a question if the mic was actually open for the
              // visitor to interrupt. With push-to-talk the mic is muted during scripted
              // narration, so a slow first utterance (cold-start TTS warmup, which routinely
              // exceeds 6s) is just the agent starting late — not a Q&A — and must not hold the
              // tour. Typed questions enter Q&A directly via onMessage, so nothing is lost.
              const lateAgentSpeech = !micMuted && lastDirectiveAt > 0 && Date.now() - lastDirectiveAt > 6000;
              if (touring && !qaActive && (recentUserSpeech || lateAgentSpeech)) enterQa();
              clearAdvance(); clearExpect();   // agent talking → cancel pending advance + interruption grace
              holdForAgent(); agentSpeaking = true; startLoop(); if (!micMuted) setState('speaking');
              // Watchdog: if the agent "speaks" but no audio lands in 3s, it has no voice.
              if (voiceWatchdog !== null) clearTimeout(voiceWatchdog);
              if (!audioSeen) voiceWatchdog = window.setTimeout(() => { if (!audioSeen) flagNoVoice(); }, 3000);
            } else {
              agentSpeaking = false; releaseAfterAgent();
              // Backsolve actual TTS pace from the just-finished utterance and roll it into
              // the lastWps EMA, so future captions get a better estimate. Must run before
              // capFinish, which snaps capStart way back to mark the line done.
              if (capActive && capWords.length > 1 && capStart > 0 && !pendingCapStart) {
                const actualDurMs = performance.now() - capStart;
                if (actualDurMs > 800) {
                  const measuredWps = capWords.length / (actualDurMs / 1000);
                  // Faster convergence than before — the wall-clock fallback path needs to
                  // catch the real TTS rate within an utterance or two.
                  if (measuredWps > 1.5 && measuredWps < 6.0) lastWps = lastWps * 0.35 + measuredWps * 0.65;
                }
              }
              capFinish();   // snap the caption to the end when speech stops
              capAlign = null; capAlignReady = false;   // drop the stale timeline so the next utterance starts clean
              if (budgetLimitReached) {
                // Daily char budget hit during the utterance we just finished. End the
                // metered session now, show the goodbye line, leave the panel up so the
                // visitor can read it before closing.
                budgetLimitReached = false;
                if (touring) { touring = false; clearAdvance(); clearExpect(); hideResume(); }
                endSession();
                setMsg(BUDGET_OVER_MSG);
                return;
              }
              if (qaActive) showResume();                    // answered a question → wait, surface Resume, never auto-advance
              // Advance at the normal pace only if the agent actually narrated (audio landed).
              // A "speaking" turn that produced no audio (voiceless/text-only config) waits the
              // longer no-speech window instead of racing ahead at the 3s silence cadence.
              else if (expectTimer === null) scheduleAdvance(spokeThisStep ? SILENCE_MS : NO_SPEECH_MS);
            }
          },
          onMessage: ({ message, role }) => {
            armIdle();
            if (role === 'user') {
              const text = (message || '').trim();
              if (text && text === lastDirective) { lastDirective = ''; return; }   // our own injected directive, not a question
              holdForAgent(); clearAdvance();
              if (touring) {
                if (qaActive && RESUME_RE.test(text)) { resumeTour(); return; }      // "continue" → pick the tour back up
                enterQa();                                                           // a real question → hold the tour
              } else if (exploring && !touring && looksLikeTourYes(text)) {
                // The agent should have called startTour, but didn't (e.g. tool not in
                // dashboard config, or it just decided to narrate instead). Take over.
                takeTour();
                return;
              }
              if (!micMuted) setState('thinking');
            } else if (role === 'agent' && message) { buildCaption(message); }
          },
          onVadScore: ({ vadScore }) => {
            if (vadScore <= 0.6) return;
            if (micMuted) return;   // mic is off; ignore phantom VAD (and any local audio leakage)
            holdForAgent(); armIdle();
            // Ignore VAD while the agent is speaking — its own output through the speakers
            // bleeds into the visitor's mic and trips VAD. Real interruptions still arrive
            // via the SDK's own interrupt detection and onMessage('user').
            if (agentSpeaking) return;
            if (touring) userSpokeAt = Date.now();
            if (pttActive) armPttSilenceTimer(PTT_TAIL_MS);   // extend the silence window each time the visitor actually speaks
            pauseForUser();
          },
          onAudio: () => {
            audioSeen = true;
            spokeThisStep = true;   // real narration audio landed → this step may auto-advance once the agent stops
            armIdle();
            if (voiceWatchdog !== null) { clearTimeout(voiceWatchdog); voiceWatchdog = null; }
            if (voiceWarned) { voiceWarned = false; setState(agentSpeaking ? 'speaking' : micMuted ? 'muted' : 'listening'); }   // slow first chunk: undo the false alarm
            // Re-anchor the caption clock to the actual audio start (instead of the
            // transcript-arrival moment), so the highlighted word tracks the spoken word.
            if (pendingCapStart && capActive) { capStart = performance.now(); pendingCapStart = false; }
            if (import.meta.env.DEV) console.log('[guide] agent audio chunk received');
          },
          onAudioAlignment: (al: { chars: string[]; char_start_times_ms: number[]; char_durations_ms: number[] }) => {
            // ElevenLabs sends per-character timing in each audio chunk. Accumulate them
            // into a master per-utterance timeline so revealCaption can sync the focus
            // word to the exact spoken character.
            if (!capActive) return;
            if (pendingCapStart) { capStart = performance.now(); pendingCapStart = false; }
            appendAlignment(al.chars, al.char_start_times_ms, al.char_durations_ms);
            if (import.meta.env.DEV && capAlign) console.log('[guide] align chunk +', al.chars.length, 'chars; tl=', capAlign.starts.length, 'lastEnd=', (capAlign.starts[capAlign.starts.length - 1] + capAlign.durs[capAlign.durs.length - 1]).toFixed(0), 'ms');
          },
          onError: (m) => { console.warn('[guide] agent error:', m); },
          onDisconnect: (d) => {
            conversation = null; voiceEnabled = false; connecting = false; agentSpeaking = false;
            if (voiceWatchdog !== null) { clearTimeout(voiceWatchdog); voiceWatchdog = null; }
            if (panelOpen) {
              if (userPaused) setState('paused');                                    // we cut it on purpose (pause)
              else if (d.reason === 'error' && allowOverrides && !overrideRetry) {
                // The WS opened then closed with an error, so the throw-catch never ran.
                // Most likely the prompt override was rejected (the dashboard's prompt
                // override toggle is off). Retry once on the dashboard prompt so the
                // visitor doesn't see "Guide offline."
                overrideRetry = true; allowOverrides = false;
                console.warn('[guide] disconnect during overrides; retrying once without them:', d.message);
                connectGuide();
              }
              else if (d.reason === 'error') flagOffline('Guide offline', d.message); // surface a dropped/failed socket
              else setState('off');
            }
          },
        });
        // If the panel was closed/paused, or the tab was hidden, while we were still
        // connecting, the session resolves now with no UI to control it — tear it
        // straight back down so the ElevenLabs agent + mic never linger in the background.
        if (!panelOpen || userPaused || document.hidden) { endSession(); return; }
      } catch (e) {
        connecting = false; conversation = null; voiceEnabled = false;
        const msg = e instanceof Error ? e.name + ': ' + e.message : String(e);
        const micBlocked = /not\s*allowed|permission|denied/i.test(msg);   // VoiceConversation needs the mic
        if (allowOverrides && !overrideRetry && !micBlocked) {
          // Likely the override was rejected (dashboard "Overrides" off). Retry once on the
          // dashboard prompt so the guide still works; keep any queued question to flush then.
          overrideRetry = true; allowOverrides = false;
          connectGuide();
          return;
        }
        pendingText = null;
        flagOffline(micBlocked ? 'Mic blocked' : 'Guide offline', msg);
        bailTourOffline();
      }
    }
    function endSession() {
      if (conversation) { try { conversation.endSession(); } catch (_) {} conversation = null; }
      voiceEnabled = false; connecting = false; micMuted = true; agentSpeaking = false;
      clearPttSilenceTimer(); pttActive = false;
      micBtn.classList.remove('is-recording');
      if (voiceWatchdog !== null) { clearTimeout(voiceWatchdog); voiceWatchdog = null; }
      disarmIdle();
      clearAdvance();
      clearExpect();
    }
    // If the voice agent can't be reached when a tour starts, don't strand the visitor in
    // the collapsed tour bar with an idle cursor — revert to the full panel (the offline
    // state is already shown) so they can retry, explore, or type. No-op outside a tour.
    function bailTourOffline() {
      if (!touring && !exploring) return;
      touring = false; tourMode = false; navigating = false; qaActive = false; exploring = false;
      clearAdvance(); clearExpect(); clearStepWatchdog(); clearCursorTimers();
      hideResume();
      setTourLayout(false);
      setMsg("The voice guide can't connect right now. You can still explore on your own, or ask me anything by text.");
      cursorFx?.hide(); cursorFx?.stop();
      orbFx?.release();
      orbFx?.swooshTo(avatarAnchor());
      choicesEl.hidden = false;
    }

    // ---- panel open / close + tour control ----
    // Tour layout: collapse the panel to a slim caption bar and move the rolling caption
    // to overlay the input (one thin line). The orb leaves the header to float free.
    function setTourLayout(on: boolean) {
      document.body.classList.toggle('tour-mode', on);
      if (on) {
        fieldEl.appendChild(msgEl);              // caption rolls over the input line
        msgEl.classList.add('guide-msg--inline');
      } else if (msgEl.parentElement === fieldEl) {
        msgHome.insertBefore(msgEl, choicesEl);  // restore to the full-panel body
        msgEl.classList.remove('guide-msg--inline', 'is-echo');
        fieldEl.classList.remove('is-typing', 'has-caption');
      }
    }
    function clearCursorTimers() {
      if (cursorPointTimer !== null) { clearTimeout(cursorPointTimer); cursorPointTimer = null; }
      if (humanTimer !== null) { clearTimeout(humanTimer); humanTimer = null; }
      humanActive = false;
    }
    // A typed question briefly shows on the bar, then clears to free the space again.
    function showEcho(text: string) {
      if (echoTimer !== null) clearTimeout(echoTimer);
      inputEl.blur();
      fieldEl.classList.remove('is-typing');
      echoing = true;
      setMsg(text);
      msgEl.classList.add('is-echo');
      echoTimer = window.setTimeout(() => {
        echoTimer = null;
        if (echoing) { echoing = false; msgEl.classList.remove('is-echo'); setMsg(''); }
      }, 3500);
    }
    function openGuide() {
      if (panelOpen) return;
      panelOpen = true;
      orb!.hidden = true;
      panel!.hidden = false;
      document.body.classList.add('tour-active');
      (window as any).__osBeacon?.hide();   // one nudge at a time: dim the desktop beacon while the guide is up
      startLoop();
      orbFx?.release();
      orbFx?.setState('idle');
      touring = false; tourMode = false;
      // Go straight to the slim Q&A bar; the agent will greet and verbally offer the tour.
      // This eagerly opens a metered ElevenLabs session since the visitor explicitly
      // opened the guide (or it auto-popped from real desktop activity).
      unlockAudio();
      enterExploring();
      setMsg('');   // let the input's "Ask me anything…" placeholder hold the space until the agent speaks
      connectGuide();
    }
    function closeGuide() {
      if (!panelOpen) return;
      panelOpen = false; touring = false; agentSpeaking = false; userPaused = false; tourMode = false; navigating = false; qaActive = false; exploring = false; exploringGreeted = false; tourFromExploring = false;
      clearPttSilenceTimer(); pttActive = false;
      micBtn.classList.remove('is-recording');
      hideResume();
      setTourLayout(false);
      cursorFx?.hide();
      cursorFx?.stop();
      clearCursorTimers();
      if (echoTimer !== null) { clearTimeout(echoTimer); echoTimer = null; } echoing = false;
      stopLoop();
      if (resumeTimer !== null) { clearTimeout(resumeTimer); resumeTimer = null; }
      endSession();
      panel!.hidden = true;
      orb!.hidden = false;
      document.body.classList.remove('tour-active');
      (window as any).__osBeacon?.show();   // dismissed → light the next folder to explore
      // Comet back home to the dormant corner.
      orbFx?.release();
      orbFx?.setState('idle');
      orbFx?.swooshTo(dormantAnchor());
      desktop()?.close();
    }
    // Free-form Q&A: slim-bar layout (orb floats free, caption rolls over the input) with
    // no scripted walkthrough. The agent greets here and verbally offers the tour; the
    // visitor's answer drives what happens (the agent calls startTour, or just answers).
    function enterExploring() {
      if (touring || exploring) return;
      exploring = true;
      choicesEl.hidden = true;
      setTourLayout(true);            // collapse panel to the slim caption bar
      orbFx?.release();
      orbFx?.swooshTo(windowPin());   // orb floats free to its bar-side spot
      // Start the cursor loop so the agent can use pointAt to gesture at things;
      // it stays hidden until a pointAt call moves+shows it.
      cursorFx?.start();
      cursorFx?.place(window.innerWidth * 0.5, window.innerHeight * 0.62);
    }
    function takeTour() {
      userPaused = false;
      qaActive = false;
      const wasExploring = exploring;
      exploring = false;        // transitioning out of free-form into the scripted tour
      hideResume();
      touring = true;
      choicesEl.hidden = true;
      setTourLayout(true);      // collapse to the slim caption bar (no-op if already slim)
      orbFx?.release();
      orbFx?.swooshTo(windowPin());   // orb comets off to float beside the window (or its corner spot)
      cursorFx?.start();
      cursorFx?.show();
      cursorFx?.place(window.innerWidth * 0.5, window.innerHeight * 0.62);   // pointer waits, then drives
      setMsg('');   // captions fill in from the agent's speech; the input placeholder holds the space until then
      if (conversation && voiceEnabled) {
        // Already connected (e.g. agent called startTour from the opening greeting);
        // run the desktop preamble, then jump into step 0 (which opens /projects).
        tourFromExploring = wasExploring;
        startTourFlow();
      } else {
        tourMode = true;          // agent leads the walkthrough as soon as it connects
        connectGuide();           // first connect; onConnect will fire startTourFlow
      }
    }
    // ---- text + mic ----
    askForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const text = inputEl.value.trim();
      if (!text) return;
      inputEl.value = '';
      if (touring && qaActive && RESUME_RE.test(text)) { resumeTour(); return; }   // typed "continue" → resume, don't ask the agent
      if (!touring && !exploring) enterExploring();   // first free-form message → slim bar layout, orb floats free
      if (exploring && !touring && looksLikeTourYes(text)) {   // typed acceptance of the tour offer → start the tour
        takeTour();
        return;
      }
      setState('thinking');
      armIdle();
      if (touring) enterQa();   // a typed question mid-tour holds the walkthrough until resume
      if (document.body.classList.contains('tour-mode')) showEcho(text);   // flash the question, then free the space
      if (conversation && voiceEnabled) { try { conversation.sendUserMessage(text); } catch (_) {} }
      else { pendingText = text; connectGuide(); }   // submit is a gesture → connect, then send on onConnect
    });
    // In the slim tour bar, focusing the input hides the rolling caption so the visitor
    // can see what they type; blurring an empty field brings the caption back.
    inputEl.addEventListener('focus', () => { if (document.body.classList.contains('tour-mode')) fieldEl.classList.add('is-typing'); });
    inputEl.addEventListener('blur', () => { if (!inputEl.value) fieldEl.classList.remove('is-typing'); });
    // While the visitor is typing or focused on the input, signal the agent that they are
    // still here (resets its inactivity timer) so it doesn't prompt "are you still there?"
    // mid-typed-question. Throttled to avoid spamming the socket.
    let lastUserActivityAt = 0;
    function pingUserActivity() {
      armIdle();
      if (!conversation || !voiceEnabled) return;
      const now = Date.now();
      if (now - lastUserActivityAt < 1000) return;
      lastUserActivityAt = now;
      try { conversation.sendUserActivity(); } catch (_) {}
    }
    inputEl.addEventListener('input', pingUserActivity);
    inputEl.addEventListener('focus', pingUserActivity);
    micBtn.addEventListener('click', () => {
      if (!conversation || !voiceEnabled) {
        if (!touring && !exploring) enterExploring();   // first voice engagement → slim bar layout
        connectGuide();
        return;
      }
      // Push-to-talk: tap to start, tap again (or wait for silence) to stop.
      if (pttActive) deactivatePtt();
      else activatePtt();
    });
    soundBtn.addEventListener('click', () => {
      outputMuted = !outputMuted;
      try { conversation && conversation.setVolume({ volume: outputMuted ? 0 : 1 }); } catch (_) {}
      soundBtn.classList.toggle('is-off', outputMuted);
      soundBtn.setAttribute('aria-label', outputMuted ? "Unmute the guide's voice" : "Mute the guide's voice");
    });

    // ---- wiring ----
    orb.addEventListener('click', () => openGuide());
    closeBtn.addEventListener('click', closeGuide);
    dismissBtn.addEventListener('click', closeGuide);
    resumeBtn.addEventListener('click', () => resumeTour());
    // Fullscreen toggle: hide the button entirely on browsers without the API. Esc still
    // exits via the browser, but we also listen for fullscreenchange so the icon flips.
    const docEl = document.documentElement as HTMLElement & { webkitRequestFullscreen?: () => Promise<void> };
    const doc = document as Document & { webkitFullscreenElement?: Element; webkitExitFullscreen?: () => Promise<void> };
    const fsSupported = !!(docEl.requestFullscreen || docEl.webkitRequestFullscreen);
    if (!fsSupported) fsBtn.hidden = true;
    const isFullscreen = () => !!(doc.fullscreenElement || doc.webkitFullscreenElement);
    function syncFsIcon() {
      const fs = isFullscreen();
      fsBtn.classList.toggle('is-fullscreen', fs);
      fsBtn.setAttribute('aria-label', fs ? 'Exit fullscreen' : 'Enter fullscreen');
    }
    fsBtn.addEventListener('click', () => {
      try {
        if (isFullscreen()) {
          (doc.exitFullscreen || doc.webkitExitFullscreen)?.call(doc);
        } else {
          (docEl.requestFullscreen || docEl.webkitRequestFullscreen)?.call(docEl);
        }
      } catch (_) {}
    });
    document.addEventListener('fullscreenchange', syncFsIcon);
    document.addEventListener('webkitfullscreenchange' as any, syncFsIcon);
    syncFsIcon();
    // Captions toggle (visitor-controlled, default off, persisted in localStorage).
    function syncCcIcon() {
      ccBtn.classList.toggle('is-on', captionsEnabled);
      ccBtn.setAttribute('aria-label', captionsEnabled ? 'Turn captions off' : 'Turn captions on');
    }
    ccBtn.addEventListener('click', () => {
      captionsEnabled = !captionsEnabled;
      try { localStorage.setItem(CAPTIONS_KEY, captionsEnabled ? 'on' : 'off'); } catch (_) {}
      syncCcIcon();
      if (!captionsEnabled) {
        // Turning off mid-utterance: clear the line so it doesn't sit half-rendered.
        capActive = false; capTrack = null; capSpans = [];
        msgEl.textContent = '';
        if (document.body.classList.contains('tour-mode')) fieldEl.classList.remove('has-caption');
      }
    });
    syncCcIcon();
    // Hard stop the agent + mic if the page is unloaded with a session live.
    window.addEventListener('pagehide', () => endSession());
    // Tab backgrounded / app minimised → end the metered session + mic shortly after
    // (cost + privacy). A quick flick back cancels it; the visitor re-engages with the
    // mic or a question when they return.
    let hideTimer: number | null = null;
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        // pause the canvas loops outright (no point burning battery on an unseen tab)
        orbFx?.stop();
        cursorFx?.stop();
        if ((conversation || connecting) && hideTimer === null) {
          hideTimer = window.setTimeout(() => { hideTimer = null; endSession(); if (panelOpen) setState('off'); }, 3000);
        }
      } else {
        orbFx?.start();
        if (touring) cursorFx?.start();
        if (hideTimer !== null) { clearTimeout(hideTimer); hideTimer = null; }
      }
    });
    tourBtn.addEventListener('click', takeTour);

    // Back-compat: a stray "start-tour" trigger still opens the guide.
    document.addEventListener('click', (e) => {
      const t = (e.target as Element).closest('[data-action="start-tour"]');
      if (t) { e.preventDefault(); openGuide(); }
    });

    // Esc closes the guide before the desktop window's own Esc handler.
    document.addEventListener('keydown', (e) => {
      if (!panelOpen) return;
      if (e.key === 'Escape' && document.activeElement !== inputEl) { e.preventDefault(); e.stopImmediatePropagation(); closeGuide(); }
    }, true);

    // Hand control back when the visitor uses their real mouse: a click on the page (not
    // the panel) stands the cursor auto-pilot down; it resumes after a short idle.
    document.addEventListener('pointerdown', (e) => {
      if (!touring) return;
      if (panel.contains(e.target as Node)) return;   // using the panel isn't "taking over"
      humanActive = true;
      cursorFx?.hide();
      cursorFx?.stop();
      clearAdvance();
      if (cursorPointTimer !== null) { clearTimeout(cursorPointTimer); cursorPointTimer = null; }
      if (humanTimer !== null) clearTimeout(humanTimer);
      humanTimer = window.setTimeout(() => {
        humanTimer = null;
        humanActive = false;
        // resume gently: bring the orb back beside whatever the visitor landed on, then
        // re-arm the (delayed) advance — don't immediately yank to the next step.
        if (touring && !userPaused && conversation) { cursorFx?.show(); repinOrb(); if (tourStep < 0) runStep(0); else scheduleAdvance(); }
      }, 5000);
    }, true);

    // Audio can only start after a real user gesture. If the guide ever connected without one
    // (the mousemove auto-pop), the SDK's output context is suspended and the agent is silent —
    // so resume every captured context on the first genuine interaction, and the voice kicks in
    // the moment the visitor does anything (e.g. clicking "Take tour"). Capture phase so it runs
    // before app handlers; left attached so a later reconnect's context is covered too.
    for (const ev of ['pointerdown', 'touchend', 'keydown', 'click']) {
      document.addEventListener(ev, resumeAllAudio, { capture: true });
    }

    // Show the dormant orb (desktop only) and snap the canvas orb onto it.
    orb.hidden = false;
    orbFx?.place(dormantAnchor());

    // Auto pop-out after ~6s of cumulative active mouse movement (once per session).
    let moveMs = 0, lastMove = 0, autoArmed = true;
    function onMove() {
      const now = Date.now();
      if (lastMove && now - lastMove < 200) moveMs += now - lastMove;
      lastMove = now;
      if (autoArmed && moveMs >= 6000) {
        autoArmed = false;
        document.removeEventListener('mousemove', onMove);
        if (!panelOpen) openGuide();
      }
    }
    document.addEventListener('mousemove', onMove);

    if (import.meta.env.DEV) (window as any).__guide = { open: openGuide, close: closeGuide, takeTour, orbFx, cursorFx, pointAtEl, avatarAnchor, dormantAnchor, windowPin, repinOrb, driveTo, iconEl, cardEl, nextArrowEl, runStep, TOUR_STEPS, cursorPointAt, resolvePointTarget, clientTools };
  }
</script>

<style>
