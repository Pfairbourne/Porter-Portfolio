---
/**
 * Guide orb — the site's voice guide, drawn as a halftone particle sphere on a
 * full-viewport overlay canvas (see src/lib/guide-orb.ts). It parks top-right
 * (desktop only); after ~10s of cumulative mouse movement, or on click, it swooshes
 * across the screen into a panel. The panel introduces the guide and offers a guided
 * tour or free exploration; a bottom bar takes typed questions and a mic enables
 * voice, both routed to an ElevenLabs Conversational AI agent (a clone of Porter's
 * voice). The orb's spines bristle while the guide speaks.
 *
 * "Take the tour" runs an agent-led, CLIENT-driven walkthrough (TOUR_STEPS in
 * src/lib/tour.ts): the panel collapses to a slim caption bar, the orb floats beside
 * the open window, and a halftone cursor (src/lib/guide-cursor.ts) clicks through the
 * desktop — folder icons, listing cards — while the agent narrates each page. The
 * cursor also points at what's being described. If the visitor grabs their real
 * mouse, the auto-pilot stands down and resumes after a short idle.
 *
 * Degrades gracefully: hidden on mobile, and a failed agent connection / blocked mic
 * surfaces a visible "offline" state rather than dead-ending silently.
 */
---
<canvas class="guide-orb-stage" id="guide-orb-stage" aria-hidden="true"></canvas>
<canvas class="guide-cursor-stage" id="guide-cursor-stage" aria-hidden="true"></canvas>

<button class="guide-orb" id="guide-orb" type="button" aria-label="Open the site guide" hidden>
  <span class="guide-orb__core" aria-hidden="true"></span>
</button>

<div class="guide-panel" id="guide-panel" role="dialog" aria-label="Site guide" aria-modal="false" hidden>
  <header class="guide-panel__head">
    <span class="guide-avatar" data-guide-avatar aria-hidden="true"><span class="guide-avatar__core"></span></span>
    <span class="guide-panel__titles">
      <span class="guide-panel__title">Porter's Guide</span>
      <span class="guide-panel__state" data-guide-state aria-live="polite"></span>
    </span>
    <button class="guide-panel__sound" type="button" data-guide-sound aria-label="Mute the guide's voice">
      <svg viewBox="0 0 18 18" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 6.7h2.4L8.8 3.8v10.4L5.4 11.3H3z" fill="currentColor" stroke="none" />
        <path class="guide-sound-wave" d="M11.4 6.6a3.4 3.4 0 0 1 0 4.8M13.4 4.6a6 6 0 0 1 0 8.8" />
        <line class="guide-sound-slash" x1="11.3" y1="5" x2="16.2" y2="13.2" />
      </svg>
    </button>
    <button class="guide-panel__captions" type="button" data-guide-captions aria-label="Turn captions on">
      <svg viewBox="0 0 18 14" width="18" height="14" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="1" y="1" width="16" height="12" rx="3" />
        <path d="M6.6 5.5 Q5.1 5.5 5.1 7 Q5.1 8.5 6.6 8.5" />
        <path d="M11.6 5.5 Q10.1 5.5 10.1 7 Q10.1 8.5 11.6 8.5" />
      </svg>
    </button>
    <button class="guide-panel__fullscreen" type="button" data-guide-fullscreen aria-label="Enter fullscreen">
      <svg class="guide-fs-enter" viewBox="0 0 14 14" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M2 5V2h3" /><path d="M9 2h3v3" /><path d="M12 9v3h-3" /><path d="M5 12H2V9" />
      </svg>
      <svg class="guide-fs-exit" viewBox="0 0 14 14" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 2v3H2" /><path d="M9 5V2h3" /><path d="M9 12V9h3" /><path d="M5 9v3H2" />
      </svg>
    </button>
    <button class="guide-panel__close" type="button" data-guide-close aria-label="Close the guide">
      <svg viewBox="0 0 12 12" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <line x1="2.5" y1="2.5" x2="9.5" y2="9.5" /><line x1="9.5" y1="2.5" x2="2.5" y2="9.5" />
      </svg>
    </button>
  </header>

  <div class="guide-panel__body">
    <p class="guide-msg" data-guide-msg aria-live="polite"></p>
    <div class="guide-choices" data-guide-choices>
      <button class="guide-btn guide-btn--primary" type="button" data-guide-tour>Take the tour</button>
      <button class="guide-btn" type="button" data-guide-dismiss>I'll explore</button>
    </div>
  </div>

  <form class="guide-ask" data-guide-ask>
    <span class="guide-ask__orb" data-guide-orb-slot aria-hidden="true"></span>
    <button class="guide-ask__mic" type="button" data-guide-mic aria-label="Enable microphone">
      <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="5.5" y="1.5" width="5" height="8.5" rx="2.5" /><path d="M3 7.5a5 5 0 0 0 10 0" /><line x1="8" y1="12.5" x2="8" y2="14.5" />
      </svg>
    </button>
    <div class="guide-ask__field" data-guide-field>
      <input class="guide-ask__input" type="text" data-guide-input placeholder="Ask me anything…" autocomplete="off" maxlength="500" />
    </div>
    <button class="guide-ask__resume" type="button" data-guide-resume hidden>Resume tour ›</button>
    <button class="guide-ask__send" type="submit" aria-label="Send">↑</button>
  </form>
</div>

<script>
  import { Conversation } from '@elevenlabs/client';
  import { TOUR_GUIDE_PROMPT, TOUR_STEPS, TOUR_CHOREOGRAPHY, DESKTOP_PREAMBLE_FOLDER_PATHS, DESKTOP_PREAMBLE_FILE_PATHS, type ChoreographyStep } from '../lib/tour';
  import { GuideOrb, type OrbState } from '../lib/guide-orb';
  import { GuideCursor } from '../lib/guide-cursor';

  const INTRO = "Hi, I'm Porter's guide. Want a quick tour of the site, or would you rather explore on your own? You can ask me anything, by voice or text.";

  const orb = document.getElementById('guide-orb') as HTMLButtonElement | null;
  const panel = document.getElementById('guide-panel') as HTMLElement | null;

  if (orb && panel && window.matchMedia('(min-width: 721px)').matches) {
    const avatar = panel.querySelector('[data-guide-avatar]') as HTMLElement;
    const stateEl = panel.querySelector('[data-guide-state]') as HTMLElement;
    const msgEl = panel.querySelector('[data-guide-msg]') as HTMLElement;
    const choicesEl = panel.querySelector('[data-guide-choices]') as HTMLElement;
    const closeBtn = panel.querySelector('[data-guide-close]') as HTMLButtonElement;
    const tourBtn = panel.querySelector('[data-guide-tour]') as HTMLButtonElement;
    const dismissBtn = panel.querySelector('[data-guide-dismiss]') as HTMLButtonElement;
    const askForm = panel.querySelector('[data-guide-ask]') as HTMLFormElement;
    const inputEl = panel.querySelector('[data-guide-input]') as HTMLInputElement;
    const fieldEl = panel.querySelector('[data-guide-field]') as HTMLElement;
    const micBtn = panel.querySelector('[data-guide-mic]') as HTMLButtonElement;
    const soundBtn = panel.querySelector('[data-guide-sound]') as HTMLButtonElement;
    const resumeBtn = panel.querySelector('[data-guide-resume]') as HTMLButtonElement;
    const orbSlot = panel.querySelector('[data-guide-orb-slot]') as HTMLElement;
    const fsBtn = panel.querySelector('[data-guide-fullscreen]') as HTMLButtonElement;
    const ccBtn = panel.querySelector('[data-guide-captions]') as HTMLButtonElement;
    const msgHome = msgEl.parentElement as HTMLElement;   // .guide-panel__body — where the caption lives outside the tour

    const desktop = () => (window as any).desktopOS as { open: (p: string) => void; close: () => void } | undefined;

    // ---- shared state ----
    let panelOpen = false;
    let touring = false;
    let resumeTimer: number | null = null;
    let advanceTimer: number | null = null;   // advance to the next tour step after a silence
    let expectTimer: number | null = null;     // grace window while the visitor might be asking
    let stepWatchdog: number | null = null;    // per-step safety net: force the tour forward if a step never advances on its own
    let exploring = false;                      // free-form Q&A mode: slim bar layout, no tour script, agent answers freely
    let exploringGreeted = false;               // sent the opening "tour or question?" directive once this panel-open
    let tourFromExploring = false;              // takeTour was called while already connected → skip the cold-start greeting
    let qaActive = false;                       // a real question is being handled mid-tour → hold until explicit resume
    let choreographyActive = false;             // scripted cursor sequence is mid-flight; pause auto-advance until it lands
    let spokeThisStep = false;                  // agent has begun speaking since the current step's directive went out (guards auto-advance from running ahead of a silent/slow-to-start agent)
    // Push-to-talk: mic is muted by default; visitor taps the mic to speak, mic auto-mutes
    // after a short tail of silence. Stops background noise + ambient talking from tripping
    // the agent every time someone in the room speaks.
    let pttActive = false;
    let pttSilenceTimer: number | null = null;
    const PTT_INITIAL_MS = 8000;     // grace window after tapping the mic before the first VAD trigger
    const PTT_TAIL_MS = 2200;        // silence after each VAD trigger before auto-muting
    let lastDirective = '';                     // last system-injected directive, so its echo isn't read as a question
    let lastDirectiveAt = 0;                    // when we sent it (ms) — used to tell a scripted reply from a Q&A reply
    let userSpokeAt = 0;                        // last VAD-detected speech (ms) — commits to Q&A on the agent's reply even if no transcript arrives
    let tourStep = 0;                           // current index into TOUR_STEPS
    let orbFx: GuideOrb | null = null;   // the halftone particle orb (drawn on the overlay canvas)
    let cursorFx: GuideCursor | null = null;   // the tour's halftone "mouse pointer"
    let navigating = false;   // a cursor-driven step is mid-flight (don't stack advances)
    let humanActive = false;  // the visitor grabbed their real mouse → auto-pilot stands down
    let cursorPointTimer: number | null = null;
    let humanTimer: number | null = null;
    let echoTimer: number | null = null; // clears a transient typed-message echo in tour mode
    let echoing = false;

    // agent
    let conversation: Conversation | null = null;
    let connecting = false;
    let voiceEnabled = false;
    let connectDeferred = false;   // guide auto-popped with no user gesture yet: hold the metered connect until the first real interaction
    let micMuted = false;
    let pendingText: string | null = null;
    let outputMuted = false;
    let userPaused = false;      // the visitor hit Pause: agent must stop listening AND talking
    let tourMode = false;        // connected via "Take the tour" → agent leads the walkthrough on connect
    // Inject the code prompt (TOUR_GUIDE_PROMPT) into the agent. Requires "Overrides"
    // enabled on the agent's dashboard Security settings. ElevenLabs hard-rejects a
    // disallowed override, so if the connection throws while overrides are on we retry
    // once without them (see the catch in connectGuide), falling back to the dashboard
    // prompt rather than stranding the visitor offline.
    const useOverrides = true;
    let allowOverrides = useOverrides;   // cleared for a one-shot retry if the override is rejected
    let overrideRetry = false;
    let audioSeen = false;       // any audio chunk arrived from the agent this session
    let voiceWarned = false;     // surfaced the "no voice from the agent" notice once
    let voiceWatchdog: number | null = null;

    // Resume a shared AudioContext during the user gesture so the agent's first
    // reply is audible. connectGuide awaits the signed URL before the SDK builds
    // its own output context, which on Safari would land outside the gesture and
    // start suspended (text shows, no voice). Resuming one here in-gesture unlocks
    // page audio so the SDK's context inherits the running state.
    let audioCtx: AudioContext | null = null;
    // Browsers block audio until a real user gesture. The ElevenLabs SDK builds its OUTPUT
    // AudioContext deep inside startSession (after awaiting mic permission + the socket) and
    // only reuses an externally-unlocked context on iOS — so on desktop, if the guide connects
    // without a prior click (e.g. the mousemove auto-pop below), that context starts 'suspended'
    // and the agent is silent (the console logs "AudioContext was not allowed to start"). The SDK
    // exposes no handle to it, so wrap the AudioContext constructor to keep a reference to every
    // context the page (and the bundled SDK) create, then resume them all on the first gesture.
    const audioContexts = new Set<AudioContext>();
    try {
      const w = window as unknown as Record<string, any>;
      for (const key of ['AudioContext', 'webkitAudioContext']) {
        const Native = w[key];
        if (typeof Native !== 'function' || Native.__guideWrapped) continue;
        const Wrapped = function (...args: any[]) {
          const ctx = new Native(...args);
          try { audioContexts.add(ctx); } catch (_) {}
          return ctx;
        };
        Wrapped.prototype = Native.prototype;
        (Wrapped as any).__guideWrapped = true;
        try { Object.setPrototypeOf(Wrapped, Native); } catch (_) {}
        w[key] = Wrapped;
      }
    } catch (_) {}
    function resumeAllAudio() {
      for (const ctx of audioContexts) {
        if (ctx.state === 'suspended') { try { void ctx.resume().catch(() => {}); } catch (_) {} }
      }
    }
    function unlockAudio() {
      try {
        const Ctx = (window as any).AudioContext || (window as any).webkitAudioContext;
        if (!Ctx) return;
        if (!audioCtx) audioCtx = new Ctx();
        if (audioCtx!.state === 'suspended') audioCtx!.resume();
        const src = audioCtx!.createBufferSource();
        src.buffer = audioCtx!.createBuffer(1, 1, 22050);
        src.connect(audioCtx!.destination);
        src.start(0);
        resumeAllAudio();   // also kick any SDK output context that was created suspended
      } catch (_) {}
    }
    type State = 'off' | 'connecting' | 'listening' | 'thinking' | 'speaking' | 'muted' | 'paused' | 'qa';
    const LABELS: Record<State, string> = {
      off: '', connecting: 'Connecting…', listening: 'Listening', thinking: 'Thinking…', speaking: 'Speaking', muted: 'Mic off', paused: 'Paused', qa: 'Ask away, or resume',
    };
    function setState(s: State) {
      if (voiceWarned && (s === 'speaking' || s === 'listening')) {
        stateEl.textContent = 'No voice, text only';   // once we know the agent sends no audio, keep it visible
        stateEl.className = 'guide-panel__state is-novoice';
      } else {
        stateEl.textContent = LABELS[s];
        stateEl.className = 'guide-panel__state is-' + s;
      }
      micBtn.classList.toggle('is-muted', s === 'muted');
      micBtn.setAttribute('aria-label', pttActive ? 'Listening, tap to stop' : 'Tap to speak');
      orbFx?.setState(ORB_STATE[s]);
    }
    function setMsg(t: string) {
      capActive = false; capTrack = null; capSpans = [];
      msgEl.textContent = t;
      if (document.body.classList.contains('tour-mode')) fieldEl.classList.toggle('has-caption', !!t);
    }
    // The agent reached "speaking" but no audio chunk arrived: it has no TTS voice
    // configured (text-only). Surface it in the panel (visible in prod, not just
    // the console) so the failure is obvious rather than a silent dead-end.
    function flagNoVoice() {
      if (voiceWarned) return;
      voiceWarned = true;
      setState('speaking');
      console.warn('[guide] Agent connected and replied, but sent NO audio. The ElevenLabs agent has no voice configured (text-only). Assign a TTS voice to the agent on the dashboard.');
    }
    // The session could not be established (signed-URL mint failed, mic blocked, WS
    // error). Make it visible in the panel instead of silently blanking, so a dead
    // connection is obvious and the console says exactly why.
    function flagOffline(label: string, detail?: string) {
      stateEl.textContent = label;
      stateEl.className = 'guide-panel__state is-offline';
      console.warn('[guide] guide unavailable:', detail || label);
    }
    // Idle auto-disconnect: end the session if nothing happens for IDLE_MS so an
    // abandoned-but-open panel never keeps billing. Re-armed by every bit of activity
    // (agent/user speech, messages, the tour advancing, mic/text), so it never fires
    // mid-tour or mid-conversation — only on genuine silence.
    let idleTimer: number | null = null;
    const IDLE_MS = 90000;
    function disarmIdle() { if (idleTimer !== null) { clearTimeout(idleTimer); idleTimer = null; } }
    function armIdle() {
      disarmIdle();
      idleTimer = window.setTimeout(() => {
        idleTimer = null;
        if (conversation || connecting) { endSession(); if (panelOpen) setState('off'); }
      }, IDLE_MS);
    }

    // ---- the orb: a halftone particle sphere on a full-viewport overlay canvas ----
    // One orb does everything: parks at the dormant button, swooshes across the screen
    // into the panel header on open, reacts to the voice (talking / listening /
    // thinking), and shoots out to point a halftone hand at whatever the guide opens.
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const stage = document.getElementById('guide-orb-stage') as HTMLCanvasElement | null;
    let agentSpeaking = false;
    let rafId = 0;
    let ampCur = 0;
    const VOICE_GAIN = 2.6;   // how hard the live voice level drives the orb (turn up = punchier)
    function anchorOf(el: HTMLElement) {
      const b = el.getBoundingClientRect();
      return { x: b.left + b.width / 2, y: b.top + b.height / 2, r: Math.max(b.width, b.height) / 2 };
    }
    // The dormant button is fixed, so cache its anchor instead of measuring every frame.
    // Cache holds until a resize, and we recompute while it's still hidden (rect = 0).
    let dormantCache: { x: number; y: number; r: number } | null = null;
    const dormantAnchor = () => {
      if (!dormantCache || dormantCache.r === 0) dormantCache = anchorOf(orb!);
      return dormantCache;
    };
    window.addEventListener('resize', () => { dormantCache = null; }, { passive: true });
    const avatarAnchor = () => anchorOf(avatar);
    // While the tour runs, the orb sits inside its frosted slot at the left edge of the
    // caption bar. The slot is a real DOM element styled like the panel, so the orb has a
    // clean visual case instead of floating loose. No bob: it stays put while pages
    // navigate; the cursor is the only thing that moves around the page.
    const ORB_R = 28;
    function windowPin() {
      if (orbSlot) {
        const r = orbSlot.getBoundingClientRect();
        if (r.width > 4) {
          // The orb's talking spines extend to ~1.5× this.r, so size it as slot/3 to keep
          // the corona inside the frosted slot rather than spilling into the mic icon.
          const innerR = Math.min(r.width, r.height) / 3;
          return { x: r.left + r.width / 2, y: r.top + r.height / 2, r: innerR };
        }
      }
      // Fallback if the slot isn't laid out yet (panel just opening): bottom-left corner.
      const bar = panel!.getBoundingClientRect();
      if (bar.width > 4 && bar.top < window.innerHeight - 8) {
        return { x: Math.max(ORB_R + 12, bar.left + ORB_R + 8), y: bar.top + bar.height / 2, r: ORB_R };
      }
      return { x: ORB_R + 16, y: window.innerHeight - (ORB_R + 64), r: ORB_R };
    }
    if (stage) {
      orbFx = new GuideOrb(stage);
      orbFx.setTracker(() => (!panelOpen ? dormantAnchor() : (touring || exploring) ? windowPin() : avatarAnchor()));
      orbFx.start();
    }
    const cursorStage = document.getElementById('guide-cursor-stage') as HTMLCanvasElement | null;
    if (cursorStage) {
      cursorFx = new GuideCursor(cursorStage);
      // its loop runs only during a tour (started in takeTour, stopped on teardown) —
      // no point animating an invisible canvas the rest of the time
    }
    // Map the panel's conversational state onto the orb's visual state.
    const ORB_STATE: Record<State, OrbState> = {
      off: 'idle', connecting: 'thinking', listening: 'listening',
      thinking: 'thinking', speaking: 'talking', muted: 'idle', paused: 'idle', qa: 'listening',
    };
    // Fly the orb out and point its halftone hand at an element, then revert. Only while
    // the guide is open, and never under reduced motion.
    let pointTimer: number | null = null;
    function pointAtEl(getEl: () => Element | null, delay = 420, ms = 2000) {
      if (!orbFx || reduceMotion || !panelOpen) return;
      if (pointTimer !== null) clearTimeout(pointTimer);
      pointTimer = window.setTimeout(() => {
        pointTimer = null;
        const el = getEl();
        if (!el || !orbFx || !panelOpen) return;
        const b = el.getBoundingClientRect();
        if (b.width === 0 && b.height === 0) return;
        orbFx.pointAt(b.left + Math.min(b.width / 2, 90), b.top + Math.min(b.height / 2, 40), ms);
      }, delay);
    }
    const pointAtWindow = () => pointAtEl(() => document.getElementById('desktop-window'), 420, 1500);
    // Re-pin the orb beside the window after it (re)opens, using a comet move in its
    // travel style. Waits for the window's open animation to settle first.
    let repinTimer: number | null = null;
    function repinOrb() {
      if (!orbFx) return;
      if (repinTimer !== null) clearTimeout(repinTimer);
      repinTimer = window.setTimeout(() => { repinTimer = null; if (touring && orbFx) orbFx.swooshTo(windowPin()); }, 380);
    }
    // ---- pointing & browsing: the cursor reads the page instead of sitting still ----
    const sleep = (ms: number) => new Promise<void>((r) => window.setTimeout(r, ms));
    const bodyEl = () => document.getElementById('desktop-window-body');
    // eased scroll of a container — smooth, unlike the browser's choppy 'smooth' behavior
    function smoothScrollTo(el: HTMLElement, top: number, dur = 850): Promise<void> {
      return new Promise((resolve) => {
        const start = el.scrollTop;
        const goal = Math.max(0, top);
        const delta = goal - start;
        if (reduceMotion || Math.abs(delta) < 2) { el.scrollTop = goal; resolve(); return; }
        const t0 = performance.now();
        const tick = () => {
          const p = Math.min(1, (performance.now() - t0) / dur);
          const e = p < 0.5 ? 2 * p * p : 1 - Math.pow(-2 * p + 2, 2) / 2; // easeInOutQuad
          el.scrollTop = start + delta * e;
          if (p < 1 && touring) requestAnimationFrame(tick);
          else resolve();
        };
        requestAnimationFrame(tick);
      });
    }
    function centerInBody(el: Element): Promise<void> {
      const body = bodyEl();
      if (!body) return Promise.resolve();
      if (!body.contains(el)) return Promise.resolve();   // target lives on the desktop, not inside the window — no scroll needed
      const br = body.getBoundingClientRect();
      const er = (el as HTMLElement).getBoundingClientRect();
      return smoothScrollTo(body, body.scrollTop + (er.top - br.top) - (body.clientHeight / 2 - er.height / 2));
    }
    function pulseEl(el: Element) {
      el.classList.add('tour-highlight');
      window.setTimeout(() => el.classList.remove('tour-highlight'), 1900);
    }
    function moveCursorToEl(el: Element) {
      if (!cursorFx || reduceMotion || humanActive) return;
      const r = (el as HTMLElement).getBoundingClientRect();
      if (r.width === 0 && r.height === 0) return;
      cursorFx.show();
      cursorFx.moveTo(r.left + Math.min(r.width * 0.4, 80), r.top + Math.min(r.height * 0.5, 28));
    }
    // Gesture at an element (scrolls it into view first). Used by the agent's pointAt tool
    // and project highlights.
    // Pick a gesture based on what we're pointing at: images/figures/cards get circled
    // (single or double), headings get a side-to-side sweep, everything else just sits.
    // Keeps the cursor alive while the agent talks about details on screen.
    function pickGesture(el: Element): { kind: 'circle' | 'doubleCircle' | 'sweep' | 'none'; } {
      const tag = el.tagName.toLowerCase();
      if (el.matches('img, figure, video, svg, picture, .project-card, [class*="screenshot"], [class*="image"]')) {
        const r = (el as HTMLElement).getBoundingClientRect();
        // Big screenshots get a slow perimeter loop; mid-size cards get a single loop.
        return { kind: r.width > 260 || r.height > 220 ? 'doubleCircle' : 'circle' };
      }
      if (['h1', 'h2', 'h3', 'blockquote'].includes(tag) || el.matches('strong, .stat, [class*="metric"], [class*="number"]')) {
        return { kind: 'sweep' };
      }
      return { kind: 'none' };
    }
    async function gestureForEl(el: Element) {
      if (!cursorFx || humanActive) return;
      const r = (el as HTMLElement).getBoundingClientRect();
      const cx = r.left + r.width / 2;
      const cy = r.top + r.height / 2;
      const g = pickGesture(el);
      if (g.kind === 'circle' || g.kind === 'doubleCircle') {
        // For big screenshots/cards trace the perimeter (with a small inset so the cursor
        // hugs the edge rather than crossing the content). For smaller elements, a tight
        // emphasis loop near the centre.
        const big = r.width > 220 || r.height > 180;
        const radius = big
