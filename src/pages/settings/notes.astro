---
import WindowLayout from '../../layouts/WindowLayout.astro';
import { getNotes, isKvConfigured } from '../../lib/kv';

export const prerender = false;

const notes = await getNotes();
const configured = isKvConfigured();

function formatTimestamp(ts: number): string {
  const d = new Date(ts);
  return d.toLocaleString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    hour: 'numeric',
    minute: '2-digit',
  });
}
---
<WindowLayout
  title="Notes — Settings"
  description="Messages left via the Notepad."
  windowTitle="notes.txt"
  parent={{ href: '/settings', label: 'settings.app' }}
>
  <header style="margin-bottom: var(--s-6);">
    <h1 class="t-h1">Notes<span class="accent">.</span></h1>
    <p class="t-italic-serif" style="margin-top: var(--s-3); max-width: 40ch;">
      Messages left on the Notepad. Newest first. Delete anything you've seen.
    </p>
    <p class="t-caption" style="margin-top: var(--s-4); color: var(--muted);">
      {notes.length} {notes.length === 1 ? 'note' : 'notes'} stored
    </p>
  </header>

  {!configured && (
    <p class="notes-warning" role="alert">
      Upstash isn't configured for this environment — notes won't actually persist.
      Set <code>UPSTASH_REDIS_REST_URL</code> + <code>UPSTASH_REDIS_REST_TOKEN</code> in Vercel env.
    </p>
  )}

  {notes.length === 0 ? (
    <p class="t-small notes-empty">
      No notes yet. Share <a class="link-subtle" href="/notepad">/notepad</a> with someone and they'll show up here.
    </p>
  ) : (
    <ul class="notes-list" id="notes-list">
      {notes.map((n) => (
        <li class="note" data-note-id={n.id}>
          <header class="note__head">
            <div class="note__from">
              <span class="note__name">{n.name}</span>
              {n.email && (
                <a class="note__email" href={`mailto:${n.email}`}>{n.email}</a>
              )}
            </div>
            <div class="note__meta">
              <time class="note__time" datetime={new Date(n.receivedAt).toISOString()}>
                {formatTimestamp(n.receivedAt)}
              </time>
              <button
                type="button"
                class="note__delete"
                data-action="delete-note"
                aria-label={`Delete note from ${n.name}`}
              >
                Delete
              </button>
            </div>
          </header>
          <p class="note__message">{n.message}</p>
        </li>
      ))}
    </ul>
  )}

  <script is:inline>
    (function () {
      var list = document.getElementById('notes-list');
      if (!list) return;
      list.addEventListener('click', async function (e) {
        var btn = e.target.closest('[data-action="delete-note"]');
        if (!btn) return;
        var li = btn.closest('.note');
        if (!li) return;
        var id = li.getAttribute('data-note-id');
        if (!id) return;
        if (!confirm('Delete this note? Cannot be undone.')) return;
        btn.disabled = true;
        btn.textContent = 'Deleting…';
        try {
          var res = await fetch('/api/admin/notes/' + encodeURIComponent(id), {
            method: 'DELETE',
          });
          if (res.ok) {
            li.style.transition = 'opacity 200ms ease, transform 200ms ease';
            li.style.opacity = '0';
            li.style.transform = 'translateX(-8px)';
            setTimeout(function () { li.remove(); }, 220);
          } else {
            btn.disabled = false;
            btn.textContent = 'Delete';
            alert('Could not delete that note.');
          }
        } catch (_) {
          btn.disabled = false;
          btn.textContent = 'Delete';
          alert('Could not delete that note.');
        }
      });
    })();
  </script>
</WindowLayout>

<style>
  .notes-warning {
    margin-bottom: var(--s-5);
    padding: var(--s-3) var(--s-4);
    background: var(--accent-soft);
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    color: var(--ink);
    font-size: 13px;
  }
  .notes-empty {
    color: var(--muted);
    padding: var(--s-6) 0;
    font-style: italic;
  }
  .notes-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
  .note {
    background: var(--bg-elev);
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    padding: var(--s-5);
    background-image:
      repeating-linear-gradient(
        to bottom,
        transparent 0px,
        transparent 27px,
        var(--rule) 27px,
        var(--rule) 28px
      );
    background-position: 0 24px;
  }
  .note__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-4);
    margin-bottom: var(--s-3);
    flex-wrap: wrap;
  }
  .note__from {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .note__name {
    font-family: var(--font-serif);
    font-size: 22px;
    line-height: 1.1;
    color: var(--ink);
  }
  .note__email {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
    text-decoration: none;
    transition: color 160ms ease;
  }
  .note__email:hover { color: var(--accent); }
  .note__meta {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }
  .note__time {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    white-space: nowrap;
  }
  .note__delete {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
    padding: 3px 10px;
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease;
  }
  .note__delete:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .note__delete:disabled {
    opacity: 0.55;
    cursor: default;
  }
  .note__message {
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink-2);
    white-space: pre-wrap;
  }
</style>
