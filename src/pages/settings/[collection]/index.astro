---
import WindowLayout from '../../../layouts/WindowLayout.astro';
import { getCollection } from 'astro:content';
import { isCollectionId, getDefinition, type CollectionId } from '../../../lib/content-form-config';

export const prerender = false;

const param = Astro.params.collection;
if (!isCollectionId(param)) {
  return Astro.redirect('/settings');
}
const collection = param as CollectionId;
const def = getDefinition(collection);

// `pages` is virtual (handled separately) — bounce to dashboard for now if requested here.
if (collection === 'pages') {
  return Astro.redirect('/settings');
}

const entries = await getCollection(collection as any);
const liveEntries = entries.filter((e: any) => !e.data?.draft);
const draftEntries = entries.filter((e: any) => e.data?.draft);

function previewLine(data: any): string {
  return (
    data?.tagline
    || data?.summary
    || data?.excerpt
    || data?.reaction
    || data?.note
    || data?.description
    || data?.artist
    || ''
  );
}

function sortKey(data: any): string | number {
  if (typeof data?.order === 'number') return -data.order; // higher order first
  if (data?.date) return -new Date(data.date).getTime();
  if (data?.year) return -Number(data.year);
  return data?.title ?? data?.label ?? '';
}

entries.sort((a: any, b: any) => {
  const ka = sortKey(a.data);
  const kb = sortKey(b.data);
  if (typeof ka === 'number' && typeof kb === 'number') return ka - kb;
  return String(ka).localeCompare(String(kb));
});

const fileExt = def.extension;
---
<WindowLayout
  title={`${def.label} — Settings`}
  description={`Manage ${def.label.toLowerCase()}.`}
  windowTitle={`${collection}/`}
  parent={{ href: '/settings', label: 'settings.app' }}
>
  <header class="list-header">
    <div>
      <div class="t-label" style="margin-bottom: var(--s-3);">{collection}/</div>
      <h1 class="t-h1">{def.label}<span class="accent">.</span></h1>
      <p class="t-italic-serif" style="max-width: 50ch; margin-top: var(--s-3);">{def.description}</p>
      <p class="t-caption" style="margin-top: var(--s-3); color: var(--muted);">
        {entries.length} {entries.length === 1 ? 'entry' : 'entries'}
        {def.hasDraftField && draftEntries.length > 0 && (
          <span> · {liveEntries.length} live · {draftEntries.length} draft</span>
        )}
      </p>
    </div>
  </header>

  {entries.length === 0 ? (
    <p class="list-empty">
      Nothing here yet. New entries are added in code at <code>src/content/{collection}/</code>.
    </p>
  ) : (
    <ul class="entry-list" data-collection={collection}>
      {entries.map((entry: any) => {
        const isDraft = Boolean(entry.data?.draft);
        const displayTitle = entry.data?.title ?? entry.data?.label ?? entry.id;
        return (
          <li class={`entry${isDraft ? ' entry--draft' : ''}`} data-entry-slug={entry.id} data-entry-title={displayTitle}>
            <a href={`/settings/${collection}/${entry.id}`} class="entry__link">
              <div class="entry__head">
                <span class="entry__filename">{entry.id}.{fileExt}</span>
                {isDraft && <span class="entry__badge">DRAFT</span>}
              </div>
              <h2 class="entry__title">{displayTitle}</h2>
              {previewLine(entry.data) && (
                <p class="entry__preview">{previewLine(entry.data)}</p>
              )}
            </a>
            <button
              type="button"
              class="entry__delete"
              data-entry-delete
              aria-label={`Delete ${displayTitle}`}
              title="Delete entry"
            >×</button>
          </li>
        );
      })}
    </ul>
  )}

  <script is:inline>
    (function () {
      var list = document.querySelector('.entry-list[data-collection]');
      if (!list) return;
      var collection = list.getAttribute('data-collection');

      list.addEventListener('click', async function (e) {
        var btn = e.target.closest('[data-entry-delete]');
        if (!btn) return;
        e.preventDefault();
        var li = btn.closest('.entry');
        if (!li) return;
        var slug = li.getAttribute('data-entry-slug');
        var title = li.getAttribute('data-entry-title') || slug;
        if (!slug) return;

        if (!confirm('Delete "' + title + '" permanently? This commits a delete to GitHub — the entry disappears on the next build.')) return;

        btn.disabled = true;
        btn.textContent = '…';
        try {
          var res = await fetch('/api/admin/content/delete', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ collection: collection, slug: slug }),
          });
          var data = await res.json().catch(function () { return {}; });
          if (res.ok && data.ok) {
            li.style.transition = 'opacity 200ms ease, transform 200ms ease';
            li.style.opacity = '0';
            li.style.transform = 'translateX(-8px)';
            setTimeout(function () { li.remove(); }, 220);
          } else {
            var err = (data && data.error) || res.statusText || 'unknown';
            alert('Delete failed: ' + err);
            btn.disabled = false;
            btn.textContent = '×';
          }
        } catch (_) {
          alert('Delete failed (network).');
          btn.disabled = false;
          btn.textContent = '×';
        }
      });
    })();
  </script>
</WindowLayout>

<style>
  .list-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--s-5);
    flex-wrap: wrap;
    margin-bottom: var(--s-6);
  }
  .list-empty {
    color: var(--muted);
    font-style: italic;
    padding: var(--s-8) 0;
  }
  .entry-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-3);
  }
  @media (min-width: 720px) {
    .entry-list { grid-template-columns: 1fr 1fr; }
  }
  .entry {
    background: var(--bg-elev);
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    transition: border-color 160ms ease, transform 160ms ease;
    position: relative;
  }
  .entry:hover { border-color: var(--ink-2); transform: translateY(-1px); }
  .entry--draft { opacity: 0.7; }
  .entry__link {
    display: block;
    padding: var(--s-4) var(--s-5);
    padding-right: calc(var(--s-5) + 28px);
    text-decoration: none;
    color: inherit;
  }
  .entry__delete {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 50%;
    color: var(--muted);
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
    opacity: 0;
    transition: opacity 160ms ease, color 160ms ease, border-color 160ms ease, background 160ms ease;
  }
  .entry:hover .entry__delete,
  .entry__delete:focus-visible { opacity: 1; }
  .entry__delete:hover {
    color: var(--bg);
    background: var(--accent);
    border-color: var(--accent);
  }
  .entry__delete:disabled { cursor: default; opacity: 0.6; }
  @media (hover: none) {
    .entry__delete { opacity: 1; }
  }
  .entry__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-3);
    margin-bottom: 4px;
  }
  .entry__filename {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--muted);
    letter-spacing: 0.04em;
  }
  .entry__badge {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.18em;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 2px 7px;
    border-radius: var(--radius-pill);
  }
  .entry__title {
    font-family: var(--font-serif);
    font-size: 19px;
    line-height: 1.2;
    color: var(--ink);
    font-weight: 400;
    margin: 0 0 4px;
  }
  .entry__preview {
    font-size: 13px;
    color: var(--ink-2);
    line-height: 1.45;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
