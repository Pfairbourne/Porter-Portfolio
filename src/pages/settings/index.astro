---
import WindowLayout from '../../layouts/WindowLayout.astro';
import { getNotes } from '../../lib/kv';
import { getCollection } from 'astro:content';
import { FORM_DEFINITIONS, type CollectionId } from '../../lib/content-form-config';

export const prerender = false;

const noteCount = (await getNotes()).length;

async function countCollection(id: CollectionId): Promise<{ total: number; drafts: number }> {
  try {
    const entries = await getCollection(id as any);
    const drafts = entries.filter((e: any) => Boolean(e.data?.draft)).length;
    return { total: entries.length, drafts };
  } catch {
    return { total: 0, drafts: 0 };
  }
}

const COLLECTION_ORDER: CollectionId[] = [
  'projects', 'fun', 'agents', 'writing', 'books', 'tracks', 'headshots',
];

const collectionCounts = await Promise.all(
  COLLECTION_ORDER.map(async (id) => ({ id, def: FORM_DEFINITIONS[id], ...(await countCollection(id)) })),
);
---
<WindowLayout
  title="Settings — Porter Fairbourne"
  description="Admin dashboard."
  windowTitle="settings.app"
>
  <header class="settings-header">
    <div>
      <div class="t-label" style="margin-bottom: var(--s-3);">Admin</div>
      <h1 class="t-h1">Settings<span class="accent">.</span></h1>
    </div>
    <form action="/api/admin/logout" method="POST">
      <button type="submit" class="btn">Log out ↩</button>
    </form>
  </header>

  <p class="t-italic-serif" style="max-width: var(--max-w-read); margin-bottom: var(--s-6);">
    Edit the whole site without redeploying. Toggles are instant; content edits commit to GitHub and
    Vercel rebuilds (~60s).
  </p>

  {import.meta.env.DEV && (
    <div class="dev-sync" role="region" aria-label="Localhost sync">
      <div class="dev-sync__text">
        <span class="dev-sync__label">Localhost</span>
        <span class="dev-sync__hint">CMS edits commit to <code>main</code> but localhost reads from disk. Pull when you want the local files to catch up.</span>
      </div>
      <button type="button" class="dev-sync__btn" data-sync-btn>Pull from main</button>
      <span class="dev-sync__status" data-sync-status aria-live="polite"></span>
    </div>
  )}

  <section>
    <div class="section-label">Live now</div>
    <div class="settings-grid">
      <a class="settings-card" href="/settings/notes">
        <div class="settings-card__head">
          <span class="settings-card__label">notes.txt</span>
          {noteCount > 0 ? (
            <span class="settings-card__instant">{noteCount} {noteCount === 1 ? 'note' : 'notes'}</span>
          ) : (
            <span class="settings-card__instant">inbox</span>
          )}
        </div>
        <h2 class="settings-card__title">Notepad inbox</h2>
        <p class="settings-card__desc">Messages visitors left via the Notepad. Browse and delete.</p>
      </a>

      <a class="settings-card" href="/settings/visibility">
        <div class="settings-card__head">
          <span class="settings-card__label">visibility.toml</span>
          <span class="settings-card__instant">instant</span>
        </div>
        <h2 class="settings-card__title">Icon visibility</h2>
        <p class="settings-card__desc">Show or hide any icon on the dock or desktop.</p>
      </a>

      <a class="settings-card" href="/settings/menubar">
        <div class="settings-card__head">
          <span class="settings-card__label">menubar.txt</span>
          <span class="settings-card__instant">instant</span>
        </div>
        <h2 class="settings-card__title">Menu bar status</h2>
        <p class="settings-card__desc">Edit the "Busy Building" line next to your name.</p>
      </a>

      <a class="settings-card" href="/settings/labels">
        <div class="settings-card__head">
          <span class="settings-card__label">labels.toml</span>
          <span class="settings-card__instant">instant</span>
        </div>
        <h2 class="settings-card__title">Icon labels</h2>
        <p class="settings-card__desc">Rename anything on the desktop or dock — "selected-work" → whatever you want.</p>
      </a>
    </div>
  </section>

  <section style="margin-top: var(--s-8);">
    <div class="section-label">Content</div>
    <div class="settings-grid">
      {collectionCounts.map(({ id, def, total, drafts }) => (
        <a class="settings-card" href={`/settings/${id}`}>
          <div class="settings-card__head">
            <span class="settings-card__label">{id}/</span>
            <span class="settings-card__count">
              {total} {total === 1 ? 'entry' : 'entries'}
              {drafts > 0 && <span class="settings-card__drafts"> · {drafts} draft</span>}
            </span>
          </div>
          <h2 class="settings-card__title">{def.label}</h2>
          <p class="settings-card__desc">{def.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section style="margin-top: var(--s-8);">
    <div class="section-label">Pages</div>
    <div class="settings-grid">
      <a class="settings-card" href="/settings/pages/about">
        <div class="settings-card__head">
          <span class="settings-card__label">pages/about.md</span>
          <span class="settings-card__count">page body</span>
        </div>
        <h2 class="settings-card__title">About</h2>
        <p class="settings-card__desc">The body of <code>/about</code> — the longer-form prose.</p>
      </a>
      <a class="settings-card" href="/settings/pages/now">
        <div class="settings-card__head">
          <span class="settings-card__label">pages/now.md</span>
          <span class="settings-card__count">page body</span>
        </div>
        <h2 class="settings-card__title">Now</h2>
        <p class="settings-card__desc">The body of <code>/now</code> — what you're up to.</p>
      </a>

      <a class="settings-card" href="/settings/pages/stack">
        <div class="settings-card__head">
          <span class="settings-card__label">pages/stack.md</span>
          <span class="settings-card__count">page body</span>
        </div>
        <h2 class="settings-card__title">Stack</h2>
        <p class="settings-card__desc">The body of <code>/stack</code> — how this site is built.</p>
      </a>
    </div>
  </section>
  <script is:inline>
    (function () {
      var btn = document.querySelector('[data-sync-btn]');
      if (!btn) return;
      var status = document.querySelector('[data-sync-status]');

      btn.addEventListener('click', async function () {
        btn.disabled = true;
        if (status) { status.textContent = 'pulling…'; status.dataset.state = 'busy'; }
        try {
          var res = await fetch('/api/admin/sync', { method: 'POST' });
          var data = await res.json().catch(function () { return {}; });
          if (res.ok && data.ok) {
            if (status) {
              status.textContent = data.summary || 'pulled';
              status.dataset.state = 'ok';
            }
          } else {
            if (status) {
              status.textContent = data.error ? 'failed: ' + data.error : 'failed';
              status.dataset.state = 'err';
            }
          }
        } catch (_) {
          if (status) { status.textContent = 'failed (network)'; status.dataset.state = 'err'; }
        } finally {
          btn.disabled = false;
        }
      });
    })();
  </script>
</WindowLayout>

<style>
  .settings-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-5);
    flex-wrap: wrap;
    margin-bottom: var(--s-6);
  }

  .settings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--s-4);
  }

  .dev-sync {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    padding: var(--s-3) var(--s-4);
    background: var(--bg-elev);
    border: 1px dashed var(--rule);
    border-radius: var(--radius-card);
    margin-bottom: var(--s-6);
    flex-wrap: wrap;
  }
  .dev-sync__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1 1 280px;
    min-width: 0;
  }
  .dev-sync__label {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
  }
  .dev-sync__hint {
    font-size: 12.5px;
    color: var(--ink-2);
    line-height: 1.45;
  }
  .dev-sync__hint code {
    font-family: var(--font-mono);
    font-size: 11.5px;
    background: var(--bg);
    padding: 1px 5px;
    border-radius: 3px;
  }
  .dev-sync__btn {
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
    padding: 6px 14px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.04em;
    color: var(--ink-2);
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease, background 160ms ease;
  }
  .dev-sync__btn:hover:not(:disabled) {
    color: var(--bg);
    background: var(--ink);
    border-color: var(--ink);
  }
  .dev-sync__btn:disabled { opacity: 0.55; cursor: default; }
  .dev-sync__status {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    min-width: 60px;
  }
  .dev-sync__status[data-state="ok"]   { color: var(--ink); }
  .dev-sync__status[data-state="err"]  { color: var(--accent); }
  .dev-sync__status[data-state="busy"] { color: var(--muted); }

  .settings-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--s-5);
    background: var(--bg-elev);
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    text-decoration: none;
    color: inherit;
    transition: border-color 160ms ease, transform 160ms ease;
  }
  .settings-card:hover {
    border-color: var(--ink-2);
    transform: translateY(-1px);
  }
  .settings-card__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--s-3);
    gap: var(--s-3);
  }
  .settings-card__label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.04em;
  }
  .settings-card__instant {
    font-family: var(--font-mono);
    font-size: 9.5px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
  }
  .settings-card__count {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--ink-2);
    letter-spacing: 0.03em;
  }
  .settings-card__drafts {
    color: var(--muted);
  }
  .settings-card__title {
    font-family: var(--font-serif);
    font-size: 22px;
    line-height: 1.15;
    color: var(--ink);
    font-weight: 400;
  }
  .settings-card__desc {
    font-size: 13.5px;
    color: var(--ink-2);
    line-height: 1.5;
  }
</style>
