---
import WindowLayout from '../../layouts/WindowLayout.astro';
import { getNotes } from '../../lib/kv';

export const prerender = false;

const noteCount = (await getNotes()).length;
---
<WindowLayout
  title="Settings — Porter Fairbourne"
  description="Admin dashboard."
  windowTitle="settings.app"
>
  <header class="settings-header">
    <div>
      <div class="t-label" style="margin-bottom: var(--s-3);">Admin</div>
      <h1 class="t-h1">Settings<span class="accent">.</span></h1>
    </div>
    <form action="/api/admin/logout" method="POST">
      <button type="submit" class="btn">Log out ↩</button>
    </form>
  </header>

  <p class="t-italic-serif" style="max-width: var(--max-w-read); margin-bottom: var(--s-8);">
    Edit live surfaces without redeploying. The toggle-y stuff (visibility, status) takes effect
    instantly; content edits land in Phase 4b.
  </p>

  <section>
    <div class="section-label">Live now</div>
    <div class="settings-grid">
      <a class="settings-card" href="/settings/notes">
        <div class="settings-card__head">
          <span class="settings-card__label">notes.txt</span>
          {noteCount > 0 ? (
            <span class="settings-card__instant">{noteCount} {noteCount === 1 ? 'note' : 'notes'}</span>
          ) : (
            <span class="settings-card__instant">inbox</span>
          )}
        </div>
        <h2 class="settings-card__title">Notepad inbox</h2>
        <p class="settings-card__desc">Messages visitors left via the Notepad. Browse and delete.</p>
      </a>

      <a class="settings-card" href="/settings/visibility">
        <div class="settings-card__head">
          <span class="settings-card__label">visibility.toml</span>
          <span class="settings-card__instant">instant</span>
        </div>
        <h2 class="settings-card__title">Icon visibility</h2>
        <p class="settings-card__desc">Show or hide any icon on the dock or desktop. Hide things while they're in progress.</p>
      </a>

      <a class="settings-card" href="/settings/menubar">
        <div class="settings-card__head">
          <span class="settings-card__label">menubar.txt</span>
          <span class="settings-card__instant">instant</span>
        </div>
        <h2 class="settings-card__title">Menu bar status</h2>
        <p class="settings-card__desc">Edit the "Busy Building" line next to your name.</p>
      </a>
    </div>
  </section>

  <section style="margin-top: var(--s-8);">
    <div class="section-label">Coming soon</div>
    <ul class="settings-list">
      <li><span class="settings-list__title">Case studies</span> — add / edit / delete <code>projects/*.md</code></li>
      <li><span class="settings-list__title">Fun projects</span> — <code>fun/*.md</code></li>
      <li><span class="settings-list__title">MindStudio agents</span> — <code>agents/*.md</code></li>
      <li><span class="settings-list__title">Writing</span> — <code>writing/*.md</code></li>
      <li><span class="settings-list__title">Reading list</span> — <code>books/*.md</code></li>
      <li><span class="settings-list__title">Tracks</span> — top 5 study tunes</li>
      <li><span class="settings-list__title">Headshots</span> — upload new portraits</li>
      <li><span class="settings-list__title">About / Now</span> — page bodies</li>
    </ul>
    <p class="t-small" style="color: var(--muted); margin-top: var(--s-4);">
      These need GitHub API commits to persist. Land in Phase 4b once the repo is wired in Vercel.
    </p>
  </section>
</WindowLayout>

<style>
  .settings-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-5);
    flex-wrap: wrap;
    margin-bottom: var(--s-6);
  }

  .settings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--s-4);
  }

  .settings-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--s-5);
    background: var(--bg-elev);
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    text-decoration: none;
    color: inherit;
    transition: border-color 160ms ease, transform 160ms ease;
  }
  .settings-card:hover {
    border-color: var(--ink-2);
    transform: translateY(-1px);
  }
  .settings-card__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--s-3);
  }
  .settings-card__label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.04em;
  }
  .settings-card__instant {
    font-family: var(--font-mono);
    font-size: 9.5px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
  }
  .settings-card__title {
    font-family: var(--font-serif);
    font-size: 22px;
    line-height: 1.15;
    color: var(--ink);
    font-weight: 400;
  }
  .settings-card__desc {
    font-size: 13.5px;
    color: var(--ink-2);
    line-height: 1.5;
  }

  .settings-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--s-2);
    margin: 0;
  }
  .settings-list li {
    color: var(--ink-2);
    font-size: 14px;
  }
  .settings-list__title {
    color: var(--ink);
    font-weight: 500;
  }
</style>
