---
import WindowLayout from '../../layouts/WindowLayout.astro';
import { getMenubarStatus, isKvConfigured } from '../../lib/kv';

export const prerender = false;

const current = await getMenubarStatus();
const configured = isKvConfigured();
---
<WindowLayout
  title="Menu bar — Settings"
  description="Edit the menu bar status string."
  windowTitle="menubar.txt"
  parent={{ href: '/settings', label: 'settings.app' }}
  narrow
>
  <header style="margin-bottom: var(--s-6);">
    <h1 class="t-h1">Menu bar status<span class="accent">.</span></h1>
    <p class="t-italic-serif" style="margin-top: var(--s-3);">
      The pulsing line next to your name. Keep it short — under 30 chars usually reads best.
    </p>
  </header>

  {!configured && (
    <p class="visibility-warning" role="alert">
      Upstash isn't configured for this environment — saves won't persist. Set
      <code>UPSTASH_REDIS_REST_URL</code> + <code>UPSTASH_REDIS_REST_TOKEN</code> in Vercel env.
    </p>
  )}

  <form id="menubar-form" class="menubar-form" novalidate>
    <label class="menubar-form__field">
      <span class="t-label">Status</span>
      <input
        type="text"
        id="menubar-input"
        name="status"
        value={current}
        required
        maxlength="80"
        autocomplete="off"
      />
    </label>

    <div class="menubar-form__preview" aria-hidden="true">
      <span class="t-label">Preview</span>
      <div class="menubar-form__preview-bar">
        <span class="menubar__brand">Porter Fairbourne<span class="accent">.</span></span>
        <span class="menubar__sep">·</span>
        <span class="menubar__status">
          <span class="menubar__pulse"></span>
          <span id="menubar-preview-text">{current}</span>
        </span>
      </div>
    </div>

    <div class="menubar-form__row">
      <p class="menubar-form__msg" id="menubar-msg" role="alert" aria-live="polite"></p>
      <button type="submit" class="btn btn-solid" id="menubar-submit">Save</button>
    </div>
  </form>

  <script is:inline>
    (function () {
      var form = document.getElementById('menubar-form');
      var input = document.getElementById('menubar-input');
      var preview = document.getElementById('menubar-preview-text');
      var submit = document.getElementById('menubar-submit');
      var msg = document.getElementById('menubar-msg');
      if (!form || !input || !preview || !submit || !msg) return;

      input.addEventListener('input', function () {
        preview.textContent = input.value || 'Busy Building';
      });

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        msg.textContent = '';
        msg.dataset.state = '';
        var value = input.value.trim();
        if (!value) {
          msg.textContent = 'Status cannot be empty.';
          msg.dataset.state = 'err';
          return;
        }
        submit.disabled = true;
        submit.textContent = 'Saving…';
        try {
          var res = await fetch('/api/admin/menubar-status', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ status: value }),
          });
          if (res.ok) {
            msg.textContent = 'Saved.';
            msg.dataset.state = 'ok';
          } else {
            msg.textContent = 'Save failed.';
            msg.dataset.state = 'err';
          }
        } catch (_) {
          msg.textContent = 'Save failed.';
          msg.dataset.state = 'err';
        } finally {
          submit.disabled = false;
          submit.textContent = 'Save';
        }
      });
    })();
  </script>
</WindowLayout>

<style>
  .visibility-warning {
    margin-bottom: var(--s-5);
    padding: var(--s-3) var(--s-4);
    background: var(--accent-soft);
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    color: var(--ink);
    font-size: 13px;
  }
  .menubar-form {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }
  .menubar-form__field { display: flex; flex-direction: column; gap: 6px; }
  .menubar-form__field input {
    padding: 10px 12px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    background: var(--bg-elev);
    color: var(--ink);
    font: inherit;
    transition: border-color 160ms ease;
  }
  .menubar-form__field input:focus {
    outline: none;
    border-color: var(--ink-2);
  }
  .menubar-form__preview { display: flex; flex-direction: column; gap: 6px; }
  .menubar-form__preview-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px var(--s-4);
    background: var(--bg-elev);
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .menubar-form__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-4);
  }
  .menubar-form__msg {
    margin: 0;
    font-size: 13px;
    color: var(--muted);
    flex: 1 1 60%;
    min-width: 0;
  }
  .menubar-form__msg[data-state="ok"]  { color: var(--accent); }
  .menubar-form__msg[data-state="err"] { color: var(--accent); }
</style>
