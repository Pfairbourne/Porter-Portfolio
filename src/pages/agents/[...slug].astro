---
import { getCollection, render } from 'astro:content';
import WindowLayout from '../../layouts/WindowLayout.astro';
import Tag from '../../components/Tag.astro';
import ImgFrame from '../../components/ImgFrame.astro';
import LinkPreview from '../../components/LinkPreview.astro';

export async function getStaticPaths() {
  const agents = (await getCollection('agents', ({ data }) => !data.draft))
    .sort((a, b) => {
      const orderDiff = (a.data.order ?? 0) - (b.data.order ?? 0);
      if (orderDiff !== 0) return orderDiff;
      return b.data.year - a.data.year;
    });

  return agents.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: i > 0 ? { slug: agents[i - 1].id, title: agents[i - 1].data.title } : null,
      next: i < agents.length - 1
        ? { slug: agents[i + 1].id, title: agents[i + 1].data.title }
        : null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;
---
<WindowLayout
  title={`${data.title} — Porter Fairbourne`}
  description={data.summary}
  windowTitle={`${entry.id}.md`}
  parent={{ href: '/agents', label: 'mindstudio-agents' }}
>
  <div class="agent-page">
    <header class="stack-5" style="margin-bottom: var(--s-8);">
      <div class="t-label">{data.title.toUpperCase()}</div>
      <h1 class="t-h1">{data.title}<span class="accent">.</span></h1>
      <p class="t-italic-serif" style="max-width: var(--max-w-read);">{data.summary}</p>
      <div class="meta-row">
        <span>{data.year}</span>
        <span>MindStudio</span>
      </div>
      {data.tags.length > 0 && (
        <div class="project-tags">
          {data.tags.map((t) => <Tag label={t} />)}
        </div>
      )}
    </header>

    <figure class="agent-page__media">
      {data.heroCaption && <figcaption class="agent-page__caption">{data.heroCaption}</figcaption>}
      <ImgFrame src={data.hero} alt={`${data.title} hero`} placeholder={`${data.title} · hero`} />
    </figure>

    <div class="prose agent-page__prose" style="margin-top: var(--s-8);">
      <Content />
    </div>

    {data.exampleOutput && (
      <section style="margin-top: var(--s-8);">
        <div class="section-label">Example output</div>
        <LinkPreview
          url={data.exampleOutput.url}
          title={data.exampleOutput.title}
          description={data.exampleOutput.description}
          image={data.exampleOutput.image}
          kicker={data.exampleOutput.kicker}
        />
      </section>
    )}

    {data.link && (
      <div style="margin-top: var(--s-8); display: flex; gap: var(--s-3); flex-wrap: wrap;">
        <a class="btn btn-solid" href={data.link} target="_blank" rel="noopener noreferrer">
          View Agent on MindStudio →
        </a>
      </div>
    )}

    {(prev || next) && (
      <nav class="case-nav" aria-label="Agent navigation">
        <div class="case-nav__cell">
          {prev && (
            <>
              <span class="t-label">← Previous</span>
              <a href={`/agents/${prev.slug}`}>{prev.title}</a>
            </>
          )}
        </div>
        <div class="case-nav__cell case-nav__cell--end">
          {next && (
            <>
              <span class="t-label">Next →</span>
              <a href={`/agents/${next.slug}`}>{next.title}</a>
            </>
          )}
        </div>
      </nav>
    )}
  </div>
</WindowLayout>

