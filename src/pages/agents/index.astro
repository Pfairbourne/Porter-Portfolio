---
import WindowLayout from '../../layouts/WindowLayout.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import Tag from '../../components/Tag.astro';
import AgentGlyph from '../../components/AgentGlyph.astro';
import { getCollection } from 'astro:content';

// Newest first (by year); within a year, lower `order` wins. Year is used for
// sorting only — never shown in the listing UI.
const agents = (await getCollection('agents', ({ data }) => !data.draft))
  .sort((a, b) => {
    const yearDiff = b.data.year - a.data.year;
    if (yearDiff !== 0) return yearDiff;
    return (a.data.order ?? 0) - (b.data.order ?? 0);
  });
---
<WindowLayout
  title="AI Agents — Porter Fairbourne"
  description="Agents and automations Porter Fairbourne has built with MindStudio."
  windowTitle="ai-agents"
>
  <section class="hero">
    <div class="t-label" style="margin-bottom: var(--s-4);">AI Agents</div>
    <h1 class="t-h1">Agents I've built<span class="accent">.</span></h1>
    <p class="ethos">
      Multi-agent systems, orchestrations, and tooling.
    </p>
  </section>

  <section>
    <SectionLabel text="All Agents" />
    <div role="list">
      {agents.length === 0 ? (
        <p class="t-small" style="color: var(--muted); padding: var(--s-5) 0;">
          New agents coming soon. Drop a markdown file in <code>src/content/agents/</code> to add one.
        </p>
      ) : (
        agents.map((a) => (
          <a
            class:list={[
              'project-card',
              'project-card--agent',
              a.data.icon && 'project-card--with-glyph',
            ]}
            href={`/agents/${a.id}`}
          >
            <div class="project-card-row">
              {a.data.icon && (
                <AgentGlyph icon={a.data.icon} uid={a.id} class="agent-glyph" />
              )}
              <div class="project-body">
                <div class="project-title">{a.data.title}</div>
                <div class="project-desc">{a.data.summary}</div>
                {a.data.tags.length > 0 && (
                  <div class="project-tags">
                    {a.data.tags.slice(0, 3).map((t) => <Tag label={t} />)}
                  </div>
                )}
              </div>
              <span class="project-arrow">↗</span>
            </div>
          </a>
        ))
      )}
    </div>
  </section>
</WindowLayout>
