---
import { getCollection, render } from 'astro:content';
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects', ({ data }) => !data.draft))
    .sort((a, b) => b.data.order - a.data.order || b.data.year - a.data.year);

  return projects.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: i > 0 ? { slug: projects[i - 1].id, title: projects[i - 1].data.title } : null,
      next: i < projects.length - 1
        ? { slug: projects[i + 1].id, title: projects[i + 1].data.title }
        : null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
---
<CaseStudyLayout
  slug={entry.id}
  title={entry.data.title}
  tagline={entry.data.tagline}
  year={entry.data.year}
  role={entry.data.role}
  team={entry.data.team}
  status={entry.data.status}
  tags={entry.data.tags}
  hero={entry.data.hero}
  heroAlt={entry.data.heroAlt}
  summary={entry.data.summary}
  links={entry.data.links}
  prev={prev}
  next={next}
>
  <Content />
</CaseStudyLayout>
