---
import WindowLayout from '../../layouts/WindowLayout.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import Tag from '../../components/Tag.astro';
import { getCollection } from 'astro:content';

// Sort uses `order` (desc), then `year` (desc) as tiebreaker. Year is kept on
// each entry for sorting only — never displayed on the listing.
const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.order - a.data.order || b.data.year - a.data.year);
---
<WindowLayout
  title="Full App Prototype — Porter Fairbourne"
  description="Breakdown of the Ember prototype across product data, validation, enrichment, publishing, workflow orchestration, and roadmap."
  windowTitle="full-app-prototype"
>
  <section class="hero">
    <div class="t-label" style="margin-bottom: var(--s-4);">Full App Prototype</div>
    <h1 class="t-h1">Things I've built<span class="accent">.</span></h1>
    <p class="ethos">
      Case studies showing the thinking, decisions, and outcomes, not just the screenshots.
    </p>
  </section>

  <section>
    <SectionLabel text="Surface-by-surface" />
    <div role="list">
      {projects.length === 0 ? (
        <p class="t-small" style="color: var(--muted); padding: var(--s-5) 0;">
          Case studies coming soon.
        </p>
      ) : (
        projects.map((p) => (
          <a class="project-card" href={`/projects/${p.id}`}>
            <div class="project-card-row" style="grid-template-columns: 1fr auto;">
              <div class="project-body">
                <div class="project-title">{p.data.title}</div>
                <div class="project-desc">{p.data.summary}</div>
                {p.data.tags.length > 0 && (
                  <div class="project-tags">
                    {p.data.tags.slice(0, 3).map((t) => <Tag label={t} />)}
                  </div>
                )}
              </div>
              <span class="project-arrow">↗</span>
            </div>
          </a>
        ))
      )}
    </div>
  </section>
</WindowLayout>
