---
import WindowLayout from '../layouts/WindowLayout.astro';
import { getCollection } from 'astro:content';

const headshots = (await getCollection('headshots'))
  .map((h) => ({ id: h.id, ...h.data }))
  .sort((a, b) => a.order - b.order);

const filename = (src: string) => src.split('/').pop() ?? src;
---
<WindowLayout
  title="Photos — Porter Fairbourne"
  description="Headshots and portraits — formal, casual, with personality. Download any version."
  windowTitle="photos.app"
>
  <section style="margin-bottom: var(--s-7); display: flex; justify-content: space-between; align-items: flex-end; gap: var(--s-5); flex-wrap: wrap;">
    <div>
      <div class="t-label" style="margin-bottom: var(--s-3);">Photos</div>
      <h1 class="t-h1">Faces of Porter<span class="accent">.</span></h1>
      <p class="t-italic-serif" style="margin-top: var(--s-3); max-width: 32ch;">
        Pick whichever fits the context. All are CC0 — use them however you like.
      </p>
    </div>
    {headshots.length > 1 && (
      <a class="btn btn-solid" href="/images/photos/headshots.zip" download>
        Download all ↓
      </a>
    )}
  </section>

  {headshots.length === 0 ? (
    <p class="t-small" style="color: var(--muted); padding: var(--s-5) 0;">
      No headshots yet. Drop image files into <code>public/images/photos/</code> and add a JSON
      entry per image in <code>src/content/headshots/</code> with <code>src</code>,
      <code>label</code>, and <code>description</code>.
    </p>
  ) : (
    <div class="photo-grid">
      {headshots.map((h) => (
        <figure class="photo">
          <a href={h.src} download class="photo__link" aria-label={`Download ${h.label}`}>
            <img class="photo__img" src={h.src} alt={h.description ?? h.label} loading="lazy" />
            <span class="photo__filename">{filename(h.src)}</span>
          </a>
          <figcaption class="photo__caption">
            <span class="photo__label">{h.label}</span>
            {h.description && <span class="photo__desc">{h.description}</span>}
            <a class="photo__download" href={h.src} download>Download ↓</a>
          </figcaption>
        </figure>
      ))}
    </div>
  )}
</WindowLayout>

<style>
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--s-5);
  }
  .photo { display: flex; flex-direction: column; gap: var(--s-3); }
  .photo__link {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    background: var(--bg-elev);
    text-decoration: none;
  }
  .photo__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 200ms ease;
  }
  .photo__link:hover .photo__img,
  .photo__link:focus-visible .photo__img { transform: scale(1.02); }
  .photo__filename {
    position: absolute;
    left: 8px;
    bottom: 8px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--ink);
    background: rgba(255, 255, 255, 0.85);
    padding: 2px 6px;
    border-radius: 3px;
    opacity: 0;
    transition: opacity 160ms ease;
  }
  .photo__link:hover .photo__filename,
  .photo__link:focus-visible .photo__filename { opacity: 1; }

  .photo__caption {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .photo__label {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--ink);
    letter-spacing: 0.02em;
  }
  .photo__desc {
    font-size: 13px;
    color: var(--ink-2);
    line-height: 1.45;
  }
  .photo__download {
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    text-decoration: none;
    transition: color 160ms ease;
    align-self: flex-start;
  }
  .photo__download:hover { color: var(--accent); }
</style>
