---
import DesktopLayout from '../layouts/DesktopLayout.astro';
import MenuBar from '../components/MenuBar.astro';
import DesktopIcon from '../components/DesktopIcon.astro';
import Dock from '../components/Dock.astro';
import FavoriteQuote from '../components/FavoriteQuote.astro';
import { getCollection } from 'astro:content';
import { getVisibility, getMenubarStatus, getIconLabels } from '../lib/kv';
import type { BrandName } from '../lib/brand-glyphs';

// Server-render so the dock + desktop icon visibility, label overrides, and
// menubar status read fresh from KV at request time (lets admin edits take
// effect without a redeploy). Cold-start cost on Vercel free tier is acceptable.
export const prerender = false;

const [dockVisibility, desktopVisibility, menubarStatus, iconLabels, projectEntries, agentEntries, funEntries] = await Promise.all([
  getVisibility('dock'),
  getVisibility('desktop'),
  getMenubarStatus(),
  getIconLabels(),
  getCollection('projects', ({ data }) => !data.draft),
  getCollection('agents', ({ data }) => !data.draft),
  getCollection('fun', ({ data }) => !data.draft),
]);

const labelFor = (id: string, fallback: string) => iconLabels[id]?.trim() || fallback;

// Halftone full-body figure (transparent PNG). The lower body intentionally
// extends below the viewport; the name + tagline overlay the white sign in the
// image. Two frames swap to produce a quick blink.
const PORTRAIT_OPEN = '/images/about/Porter_eyesOpen.png';
const PORTRAIT_CLOSED = '/images/about/Porter_eyesClosed.png';
const PORTRAIT_ALT = 'Porter Fairbourne — halftone portrait holding a blank sign';

type IconConfig = {
  id: string;
  href: string;
  label: string;
  ext?: string;
  variant: 'file' | 'folder';
  external?: boolean;
  download?: boolean;
  /** Brand glyph for folder icons. Ignored when variant === 'file'. */
  brand?: BrandName;
};

// Left group renders as a 3-column grid: row 1 = the three folders, row 2 =
// two files. This is the "home" arrangement the Tidy-icons button resets to.
const leftIcons: IconConfig[] = [
  { id: 'selected-work', href: '/projects', label: 'full-app-prototype', variant: 'folder', brand: 'prototype' },
  { id: 'ai-agents', href: '/agents', label: 'ai-agents', variant: 'folder', brand: 'robot' },
  { id: 'fun-projects', href: '/fun', label: 'internal-tools', variant: 'folder', brand: 'toolbox' },
  { id: 'resume', href: '/resume', label: 'résumé.pdf', ext: 'pdf', variant: 'file' },
  { id: 'about', href: '/about', label: 'about.md', ext: 'md', variant: 'file' },
];

// Right group. About-this-site (/stack) and the style guide (/style-guide)
// live in the Help menu instead, so the desktop keeps only the now file.
const rightIcons: IconConfig[] = [
  { id: 'now', href: '/now', label: 'now.txt', ext: 'txt', variant: 'file' },
];

const MAIL_TO = 'mailto:pfairbourne@gmail.com';
const LINKEDIN = 'https://www.linkedin.com/in/porter-fairbourne-6a472a28a/';

// Mobile home: the phone layout drops the OS metaphor for a clean scrollable
// list. Same ids as the desktop icons/dock (so admin show/hide carries over via
// the visibility maps) but plain, recruiter-facing labels rather than the
// file-system names. style-guide / settings / the quote launcher are omitted.
type MobileLink = { id: string; href: string; label: string; count?: number };

const workLinks: MobileLink[] = [
  { id: 'selected-work', href: '/projects', label: 'Projects', count: projectEntries.length },
  { id: 'ai-agents', href: '/agents', label: 'AI Agents', count: agentEntries.length },
  { id: 'fun-projects', href: '/fun', label: 'Internal Tools', count: funEntries.length },
];
const aboutLinks: MobileLink[] = [
  { id: 'about', href: '/about', label: 'About' },
  { id: 'now', href: '/now', label: 'Now' },
  { id: 'stack', href: '/stack', label: 'Stack' },
  { id: 'resume', href: '/resume', label: 'Résumé' },
];
const moreLinks: MobileLink[] = [
  { id: 'photos', href: '/photos', label: 'Photos' },
  { id: 'reader', href: '/books', label: 'Reading' },
  { id: 'movies', href: '/movies', label: 'Movies' },
  { id: 'calendar', href: '/calendar', label: 'Calendar' },
  { id: 'mail', href: MAIL_TO, label: 'Contact' },
];

const visibleWork = workLinks.filter((l) => desktopVisibility[l.id] !== false);
const visibleAbout = aboutLinks.filter((l) => desktopVisibility[l.id] !== false);
const visibleMore = moreLinks.filter((l) => dockVisibility[l.id] !== false);
---
<DesktopLayout
  title="Porter Fairbourne — Product Manager"
  description="The workspace of Porter Fairbourne — Product Manager, Builder, and Operator. Click around — every icon is a file."
>
  <!-- Full-body figure with the name + tagline overlaying the white sign.
       Fixed-position layer behind icon clicks; lower body extends offscreen. -->
  <figure class="hero-figure" aria-label="Porter Fairbourne">
    <div class="hero-figure__stack">
      <img
        class="hero-figure__img"
        src={PORTRAIT_OPEN}
        alt={PORTRAIT_ALT}
        onerror="this.style.display='none'"
      />
      <img
        class="hero-figure__img hero-figure__img--blink"
        src={PORTRAIT_CLOSED}
        alt=""
        aria-hidden="true"
        id="portrait-blink"
        onerror="this.style.display='none'"
      />
      <figcaption class="hero-figure__sign">
        <div class="hero-figure__name">Porter Fairbourne<span class="accent">.</span></div>
        <p class="hero-figure__tagline">Product Manager, Builder, and Operator.</p>
      </figcaption>
    </div>
  </figure>

  <div class="os">
    <MenuBar status={menubarStatus} />

    <div class="surface">
      <!-- Left column -->
      <nav class="icon-column" aria-label="Work">
        {leftIcons.filter((i) => desktopVisibility[i.id] !== false).map((icon) => (
          <DesktopIcon
            id={icon.id}
            href={icon.href}
            label={labelFor(icon.id, icon.label)}
            ext={icon.ext}
            variant={icon.variant}
            brand={icon.brand}
          />
        ))}
      </nav>

      <!-- Right column -->
      <nav class="icon-column" aria-label="About">
        {rightIcons.filter((i) => desktopVisibility[i.id] !== false).map((icon) => (
          <DesktopIcon
            id={icon.id}
            href={icon.href}
            label={labelFor(icon.id, icon.label)}
            ext={icon.ext}
            variant={icon.variant}
            external={icon.external}
            download={icon.download}
          />
        ))}
      </nav>
    </div>
  </div>

  <!-- Mobile home (shown ≤720px) — clean scrollable layout; the desktop OS
       metaphor above is hidden at this breakpoint. -->
  <main class="mhome">
    <header class="mhome__head">
      <h1 class="mhome__name">Porter Fairbourne<span class="accent">.</span></h1>
      <p class="mhome__tag">Product Manager, Builder, and Operator.</p>
      <div class="mhome__meta">
        <span class="mhome__status"><span class="mhome__pulse" aria-hidden="true"></span>{menubarStatus}</span>
        <a class="mhome__cta" href={LINKEDIN} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
      </div>
    </header>

    {[
      { label: 'Work', items: visibleWork },
      { label: 'About', items: visibleAbout },
      { label: 'More', items: visibleMore },
    ].map((section) => (
      <nav class="mhome__section" aria-label={section.label}>
        <h2 class="mhome__label">{section.label}</h2>
        <ul class="mhome__list">
          {section.items.map((l) => (
            <li>
              <a class="mrow" href={l.href}>
                <span class="mrow__label">{l.label}</span>
                {l.count != null && <span class="mrow__count">{l.count}</span>}
                <svg class="mrow__chev" viewBox="0 0 8 14" width="8" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 1l6 6-6 6" /></svg>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </main>

  <Dock visibility={dockVisibility} labels={iconLabels} />

  <!-- Paper-airplane "Favorite quote" feature — launched by the dock's quote icon -->
  <FavoriteQuote />

  <!-- Floating window — opens when a file/folder is clicked -->
  <div class="desktop-window" id="desktop-window" role="dialog" aria-modal="true" aria-labelledby="desktop-window-title" hidden>
    <div class="window">
      <div class="window__chrome">
        <div class="window__title" id="desktop-window-title" aria-label="Path">—</div>
        <button class="window__close" type="button" data-close aria-label="Close (Esc)" title="Close (Esc)">
          <svg viewBox="0 0 12 12" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
            <line x1="2.5" y1="2.5" x2="9.5" y2="9.5" />
            <line x1="9.5" y1="2.5" x2="2.5" y2="9.5" />
          </svg>
        </button>
      </div>
      <div class="window__content" id="desktop-window-body"></div>
    </div>
  </div>

  <script is:inline>
    // — Desktop window controller —
    // Intercepts clicks on file/folder icons (and internal links inside the open window).
    // Fetches the target page's window content, injects it into the floating window,
    // and updates the URL via History API. No actual navigation.
    (function () {
      var modal = document.getElementById('desktop-window');
      var titleEl = document.getElementById('desktop-window-title');
      var bodyEl = document.getElementById('desktop-window-body');
      if (!modal || !titleEl || !bodyEl) return;

      var WINDOWED_PREFIXES = [
        '/about', '/now', '/stack', '/resume', '/fun', '/projects',
        '/agents', '/style-guide', '/photos', '/books', '/movies', '/calendar',
        '/ask'
      ];
      var ORIGINAL_TITLE = document.title;
      var cache = {};
      var triggerEl = null;

      function isWindowedPath(pathname) {
        for (var i = 0; i < WINDOWED_PREFIXES.length; i++) {
          var p = WINDOWED_PREFIXES[i];
          if (pathname === p || pathname.indexOf(p + '/') === 0) return true;
        }
        return false;
      }

      function shouldIntercept(link) {
        if (!link || !link.href) return false;
        var url;
        try { url = new URL(link.href); } catch (_) { return false; }
        if (url.origin !== location.origin) return false;
        if (link.target === '_blank') return false;
        if (link.hasAttribute('download')) return false;
        if (link.protocol === 'mailto:' || link.protocol === 'tel:') return false;
        if (url.pathname.endsWith('.pdf') || url.pathname.endsWith('.html')) return false;
        return isWindowedPath(url.pathname);
      }

      function setOpen(open) {
        if (open) {
          modal.removeAttribute('hidden');
          document.body.classList.add('has-modal');
        } else {
          modal.setAttribute('hidden', '');
          document.body.classList.remove('has-modal');
        }
      }

      // Scripts inserted via innerHTML don't run. Re-create each as a fresh
      // element so the browser executes it (the /calendar cal.com embed needs this).
      function runScripts(container) {
        var scripts = container.querySelectorAll('script');
        for (var i = 0; i < scripts.length; i++) {
          var old = scripts[i];
          var fresh = document.createElement('script');
          for (var a = 0; a < old.attributes.length; a++) {
            fresh.setAttribute(old.attributes[a].name, old.attributes[a].value);
          }
          fresh.text = old.textContent;
          old.parentNode.replaceChild(fresh, old);
        }
      }

      function openWindowAt(path, push, trigger) {
        if (trigger) triggerEl = trigger;
        setOpen(true);
        bodyEl.innerHTML = '<div class="modal-loading">opening…</div>';
        titleEl.textContent = '';
        bodyEl.scrollTop = 0;

        var pending = cache[path] || (cache[path] = fetch(path, { credentials: 'same-origin' }).then(function (r) {
          if (!r.ok) throw new Error('not found');
          return r.text();
        }));

        pending.then(function (html) {
          var doc = new DOMParser().parseFromString(html, 'text/html');
          var content = doc.querySelector('.window__content');
          var title = doc.querySelector('.window__title');
          var pageTitle = doc.querySelector('title');
          if (content) { bodyEl.innerHTML = content.innerHTML; runScripts(bodyEl); }
          else bodyEl.innerHTML = '<div class="modal-error">No content found.</div>';
          if (title) titleEl.innerHTML = title.innerHTML;
          if (pageTitle) document.title = pageTitle.textContent;
          bodyEl.scrollTop = 0;
          var closeBtn = modal.querySelector('.window__close');
          if (closeBtn) closeBtn.focus({ preventScroll: true });

          // Auto-size same-origin iframes (e.g. the embedded résumé) to content height
          var frames = bodyEl.querySelectorAll('iframe');
          for (var i = 0; i < frames.length; i++) {
            (function (frame) {
              function fit() {
                try {
                  var h = frame.contentDocument && frame.contentDocument.body
                    ? frame.contentDocument.body.scrollHeight + 24
                    : 0;
                  if (h > 0) frame.style.height = h + 'px';
                } catch (_) {}
              }
              if (frame.contentDocument && frame.contentDocument.readyState === 'complete') {
                fit();
              } else {
                frame.addEventListener('load', fit);
              }
            })(frames[i]);
          }
        }).catch(function () {
          delete cache[path];
          bodyEl.innerHTML = '<div class="modal-error">Could not open this file.</div>';
        });

        if (push) {
          history.pushState({ modal: path }, '', path);
        }
      }

      function closeWindow(push) {
        setOpen(false);
        bodyEl.innerHTML = '';
        titleEl.textContent = '';
        document.title = ORIGINAL_TITLE;
        if (push) {
          history.pushState({ modal: null }, '', '/');
        }
        if (triggerEl && document.body.contains(triggerEl)) {
          triggerEl.focus({ preventScroll: true });
        }
        triggerEl = null;
      }

      // Initial state — if we were redirected here from a direct hit on a windowed URL
      // (refresh / share link / bookmark), restore that URL and open the modal.
      var initialPath = null;
      try {
        var stash = sessionStorage.getItem('porter-os/open');
        if (stash && stash !== '/' && isWindowedPath(stash)) {
          sessionStorage.removeItem('porter-os/open');
          initialPath = stash;
        }
      } catch (_) {}

      if (initialPath) {
        history.replaceState({ modal: initialPath }, '', initialPath);
        openWindowAt(initialPath, false, null);
      } else if (!history.state) {
        history.replaceState({ modal: null }, '', location.pathname);
      }

      // Delegated click handler
      document.addEventListener('click', function (e) {
        if (e.defaultPrevented) return;

        // Close on backdrop or close button
        if (modal.contains(e.target)) {
          var closer = e.target.closest('[data-close]');
          if (closer) {
            e.preventDefault();
            closeWindow(true);
            return;
          }
          if (e.target === modal) {
            e.preventDefault();
            closeWindow(true);
            return;
          }
        }

        // Find an anchor we should intercept
        var link = e.target.closest('a');
        if (!link) return;
        if (!shouldIntercept(link)) return;
        if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

        e.preventDefault();
        openWindowAt(new URL(link.href).pathname, true, link);
      });

      // Esc closes
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !modal.hasAttribute('hidden')) {
          closeWindow(true);
        }
      });

      // Browser back/forward
      window.addEventListener('popstate', function () {
        var path = location.pathname;
        if (path === '/' || !isWindowedPath(path)) {
          closeWindow(false);
        } else {
          openWindowAt(path, false, null);
        }
      });
    })();
  </script>

  <script is:inline>
    // — Portrait blink controller —
    // Randomized blinks every 2.2–5.4s, ~130ms duration, ~12% chance of double blink.
    // Skips when tab is hidden or user prefers reduced motion.
    (function () {
      var blink = document.getElementById('portrait-blink');
      if (!blink) return;
      // Desktop-only: the portrait is hidden ≤720px, so skip the blink timers.
      if (!window.matchMedia('(min-width: 721px)').matches) return;
      var mq = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)');
      if (mq && mq.matches) return;

      function rand(min, max) { return min + Math.random() * (max - min); }

      function schedule() {
        var delay = rand(2200, 5400);
        setTimeout(function () {
          if (document.hidden) { schedule(); return; }
          blink.style.opacity = '1';
          setTimeout(function () {
            blink.style.opacity = '0';
            if (Math.random() < 0.12) {
              setTimeout(function () {
                blink.style.opacity = '1';
                setTimeout(function () {
                  blink.style.opacity = '0';
                  schedule();
                }, 110);
              }, 170);
            } else {
              schedule();
            }
          }, 130);
        }, delay);
      }
      schedule();
    })();
  </script>

  <script is:inline>
    (function () {
      var KEY = 'porter-os/icons-v1';
      var root = document.querySelector('.os');
      var surface = document.querySelector('.surface');
      if (!root || !surface) return;
      // Desktop-only: the icon grid is hidden ≤720px; measuring a display:none
      // surface yields zero rects, so don't initialize dragging on phones.
      if (!window.matchMedia('(min-width: 721px)').matches) return;

      var icons = Array.prototype.slice.call(document.querySelectorAll('.icon[data-icon-id]'));
      if (!icons.length) return;

      // Load saved positions
      var saved = {};
      try { saved = JSON.parse(localStorage.getItem(KEY) || '{}') || {}; } catch (_) { saved = {}; }

      function measureNatural() {
        var surfRect = surface.getBoundingClientRect();
        var out = {};
        for (var i = 0; i < icons.length; i++) {
          var r = icons[i].getBoundingClientRect();
          out[icons[i].getAttribute('data-icon-id')] = {
            x: Math.round(r.left - surfRect.left),
            y: Math.round(r.top - surfRect.top)
          };
        }
        return out;
      }

      function constrain(x, y, w, h) {
        var sw = surface.clientWidth;
        var sh = surface.clientHeight;
        return {
          x: Math.max(0, Math.min(sw - w, x)),
          y: Math.max(0, Math.min(sh - h, y))
        };
      }

      // Logical (unclamped) position we want each icon at. The displayed
      // position is this clamped to the current surface size. Keeping the
      // logical position separate means a transient window shrink — e.g. macOS
      // Split View opening when the Mail icon's mailto: link fires — tucks icons
      // in to stay on-screen, then returns them home when the window grows back,
      // instead of permanently stranding them at the edge.
      var desired = {};

      function place(icon) {
        var d = desired[icon.getAttribute('data-icon-id')] || { x: 0, y: 0 };
        var fixed = constrain(d.x, d.y, icon.offsetWidth || 104, icon.offsetHeight || 104);
        icon.style.left = fixed.x + 'px';
        icon.style.top = fixed.y + 'px';
      }

      function init() {
        var natural = measureNatural();
        root.classList.add('os--free');
        for (var i = 0; i < icons.length; i++) {
          var icon = icons[i];
          var id = icon.getAttribute('data-icon-id');
          desired[id] = saved[id] || natural[id] || { x: 0, y: 0 };
          place(icon);
        }
      }

      // Wait for fonts so layout has settled before measuring
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(init);
      } else {
        // fallback if Font Loading API is missing
        if (document.readyState === 'complete') init();
        else window.addEventListener('load', init);
      }

      function persist() {
        try { localStorage.setItem(KEY, JSON.stringify(saved)); } catch (_) {}
      }

      // Drag state (single active drag at a time)
      var active = null;
      var startX = 0, startY = 0, originX = 0, originY = 0;
      var moved = false;

      icons.forEach(function (icon) {
        icon.addEventListener('pointerdown', function (e) {
          if (e.pointerType === 'mouse' && e.button !== 0) return;
          if (!root.classList.contains('os--free')) return;
          active = icon;
          startX = e.clientX;
          startY = e.clientY;
          originX = parseFloat(icon.style.left) || 0;
          originY = parseFloat(icon.style.top) || 0;
          moved = false;
          try { icon.setPointerCapture(e.pointerId); } catch (_) {}
          icon.classList.add('icon--dragging');
        });

        icon.addEventListener('pointermove', function (e) {
          if (active !== icon) return;
          var dx = e.clientX - startX;
          var dy = e.clientY - startY;
          if (!moved && (Math.abs(dx) > 4 || Math.abs(dy) > 4)) moved = true;
          if (moved) {
            var next = constrain(originX + dx, originY + dy, icon.offsetWidth, icon.offsetHeight);
            icon.style.left = next.x + 'px';
            icon.style.top = next.y + 'px';
          }
        });

        function endDrag(e) {
          if (active !== icon) return;
          icon.classList.remove('icon--dragging');
          try { icon.releasePointerCapture(e.pointerId); } catch (_) {}
          if (moved) {
            var dropped = {
              x: parseFloat(icon.style.left) || 0,
              y: parseFloat(icon.style.top) || 0
            };
            var dropId = icon.getAttribute('data-icon-id');
            desired[dropId] = dropped;
            saved[dropId] = dropped;
            persist();
          }
          active = null;
        }
        icon.addEventListener('pointerup', endDrag);
        icon.addEventListener('pointercancel', endDrag);

        // If a drag occurred, suppress the click so we don't navigate
        icon.addEventListener('click', function (e) {
          if (moved) {
            e.preventDefault();
            e.stopPropagation();
            moved = false;
          }
        });

        // Stop the browser's native drag image
        icon.addEventListener('dragstart', function (e) { e.preventDefault(); });
      });

      // Reset desktop: clear saved positions and reload
      document.addEventListener('click', function (e) {
        var t = e.target;
        while (t && t !== document.body) {
          if (t.getAttribute && t.getAttribute('data-action') === 'reset-desktop') {
            e.preventDefault();
            try { localStorage.removeItem(KEY); } catch (_) {}
            location.reload();
            return;
          }
          t = t.parentNode;
        }
      });

      // Re-place icons on resize: clamp each one's logical position to the new
      // surface size. Shrinking tucks them in; growing back returns them home.
      var resizeTimer = null;
      window.addEventListener('resize', function () {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(function () {
          for (var i = 0; i < icons.length; i++) place(icons[i]);
        }, 150);
      });
    })();
  </script>

  <script is:inline>
    // — Onboarding guide beacon —
    // A single pulsing ember dot guides first-time visitors to open three
    // folders in order. The dot sits on the first UNOPENED target; opening it
    // clears the dot (pop-out) and advances to the next. State persists in
    // localStorage, so once a folder is opened its light never returns. After
    // all three, the desktop is clean.
    (function () {
      // Desktop-only: the folder icons this lights are hidden ≤720px.
      if (!window.matchMedia('(min-width: 721px)').matches) return;
      var KEY = 'porter-os/onboarding-v1';
      var ORDER = ['selected-work', 'ai-agents', 'fun-projects'];
      var PATHS = [['/projects', 'selected-work'], ['/agents', 'ai-agents'], ['/fun', 'fun-projects']];

      var reduced = false;
      try { reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (_) {}

      var opened = {};
      try { var s = JSON.parse(localStorage.getItem(KEY) || '{}'); opened = (s && s.opened) || {}; } catch (_) { opened = {}; }
      function persist() {
        try { localStorage.setItem(KEY, JSON.stringify({ opened: opened })); } catch (_) {}
      }

      function iconById(id) { return document.querySelector('.icon[data-icon-id="' + id + '"]'); }

      function nextTarget() {
        for (var i = 0; i < ORDER.length; i++) {
          var id = ORDER[i];
          if (opened[id]) continue;
          if (!iconById(id)) continue;       // hidden / absent → skip past it
          return id;
        }
        return null;
      }

      var currentId = null;
      var beaconEl = null;

      function showBeacon(id) {
        var icon = iconById(id);
        if (!icon) return;
        var glyph = icon.querySelector('.icon__glyph');
        if (!glyph) return;
        var el = document.createElement('span');
        el.className = 'guide-beacon';
        el.setAttribute('aria-hidden', 'true');
        glyph.appendChild(el);
        beaconEl = el;
        currentId = id;
        icon.classList.add('icon--guide-active');
        if (reduced) {
          el.classList.add('is-on');         // CSS strips the animation under reduced-motion
        } else {
          void el.offsetWidth;               // force a reflow so the appear transition runs
          el.classList.add('is-on');         // (reliable even when rAF is throttled / tab hidden)
        }
      }

      function clearBeacon(animate, done) {
        var el = beaconEl;
        var icon = currentId ? iconById(currentId) : null;
        if (icon) icon.classList.remove('icon--guide-active');
        beaconEl = null;
        currentId = null;
        if (!el) { if (done) done(); return; }
        if (!animate || reduced) {
          if (el.parentNode) el.parentNode.removeChild(el);
          if (done) done();
          return;
        }
        el.classList.remove('is-on');
        el.classList.add('is-clearing');
        var removed = false;
        function rm() {
          if (removed) return;
          removed = true;
          if (el.parentNode) el.parentNode.removeChild(el);
          if (done) done();
        }
        el.addEventListener('transitionend', rm);
        setTimeout(rm, 340);                  // fallback if transitionend doesn't fire
      }

      function render() {
        var next = nextTarget();
        if (next === currentId) return;       // already correct (incl. both null)
        clearBeacon(false, function () { if (next) showBeacon(next); });
      }

      function markOpened(id) {
        if (opened[id]) return;
        opened[id] = true;
        persist();
        if (id === currentId) {
          clearBeacon(true, function () {     // pop the dot out, then advance
            var next = nextTarget();
            if (next) showBeacon(next);
          });
        } else {
          render();                           // opened out of order; keep dot on first-unopened
        }
      }

      // Deep-link / refresh restore opens a folder with no click — the window
      // controller has already rewritten location.pathname to that path, so
      // mark it opened on load so we don't light the folder being viewed.
      var changed = false;
      for (var p = 0; p < PATHS.length; p++) {
        var prefix = PATHS[p][0], pid = PATHS[p][1];
        if (location.pathname === prefix || location.pathname.indexOf(prefix + '/') === 0) {
          if (!opened[pid]) { opened[pid] = true; changed = true; }
        }
      }
      if (changed) persist();

      // Mark a target opened whenever its icon is clicked. Dragged clicks are
      // suppressed upstream (stopPropagation in the icon-position script), so a
      // drag never reaches this listener.
      document.addEventListener('click', function (e) {
        var node = e.target;
        var icon = node && node.closest ? node.closest('.icon[data-icon-id]') : null;
        if (!icon) return;
        var id = icon.getAttribute('data-icon-id');
        if (ORDER.indexOf(id) === -1) return;
        markOpened(id);
      });

      function init() { render(); }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
      else init();
    })();
  </script>
</DesktopLayout>
