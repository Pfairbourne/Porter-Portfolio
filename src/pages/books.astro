---
import WindowLayout from '../layouts/WindowLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import { getCollection } from 'astro:content';

const books = (await getCollection('books', ({ data }) => !data.draft))
  .map((b) => b.data)
  .sort((a, b) => a.order - b.order);

const currentlyReading = books.filter((b) => b.section === 'currently-reading');
const shapedMe = books.filter((b) => b.section === 'shaped-me');
const recent = books.filter((b) => b.section === 'recent');
---
<WindowLayout
  title="Reading List — Porter Fairbourne"
  description="Books I'm reading, books that shaped how I think, recent reads."
  windowTitle="books.app"
>
  <section style="margin-bottom: var(--s-7);">
    <h1 class="t-h1">My Most Influential Reads<span class="accent">.</span></h1>
  </section>

  {currentlyReading.length > 0 && (
    <aside class="book-callout" aria-label="Currently reading">
      <span class="t-label" style="color: var(--accent);">Currently reading</span>
      <div class="book-callout__list">
        {currentlyReading.map((b) => (
          <div class="book book--callout">
            {b.cover && <img class="book__cover" src={b.cover} alt={`Cover of ${b.title}`} />}
            <div class="book__meta">
              <h3 class="book__title">{b.title}</h3>
              <p class="book__author">{b.author}</p>
              {b.reaction && <p class="book__reaction">{b.reaction}</p>}
            </div>
          </div>
        ))}
      </div>
    </aside>
  )}

  {shapedMe.length > 0 && (
    <section style="margin-top: var(--s-8);">
      <SectionLabel text="Books that shaped how I think" />
      <div class="fav-list">
        {shapedMe.map((b) => (
          <article class="fav">
            {b.cover && (
              <img class="fav__cover" src={b.cover} alt={`Cover of ${b.title}`} loading="lazy" />
            )}
            <div class="fav__body">
              <h3 class="fav__title">{b.title}</h3>
              <p class="fav__author">{b.author}</p>
              {b.reaction && <p class="fav__reason">{b.reaction}</p>}
              {b.quote && <p class="fav__quote">{b.quote}</p>}
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  {recent.length > 0 && (
    <section style="margin-top: var(--s-8);">
      <SectionLabel text="Recent reads" />
      <div class="book-list">
        {recent.map((b) => (
          <article class="book">
            {b.cover && <img class="book__cover" src={b.cover} alt={`Cover of ${b.title}`} />}
            <div class="book__meta">
              <h3 class="book__title">{b.title}</h3>
              <p class="book__author">{b.author}</p>
              {b.reaction && <p class="book__reaction">{b.reaction}</p>}
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  {books.length === 0 && (
    <p class="t-small" style="color: var(--muted); padding: var(--s-5) 0;">
      No books yet. Add markdown files to <code>src/content/books/</code> — each needs frontmatter
      with <code>title</code>, <code>author</code>, and <code>section</code>
      (<code>currently-reading</code>, <code>shaped-me</code>, or <code>recent</code>).
    </p>
  )}
</WindowLayout>
