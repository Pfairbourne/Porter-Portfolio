---
import WindowLayout from '../layouts/WindowLayout.astro';
---
<WindowLayout
  title="Not found — Porter Fairbourne"
  description="The page you're looking for doesn't exist."
  windowTitle="404.txt"
  narrow
>
  <section>
    <div class="t-label" style="margin-bottom: var(--s-4);">404</div>
    <h1 class="t-display">Nothing here<span class="accent">.</span></h1>
    <p class="ethos" style="margin-top: var(--s-5);">
      The page you're looking for moved, never existed, or I haven't built it yet.
    </p>
    <div style="margin-top: var(--s-6);">
      <a class="link-arrow" href="/">Back to the desktop</a>
    </div>
  </section>
</WindowLayout>
