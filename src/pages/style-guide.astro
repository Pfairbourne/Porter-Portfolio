---
import WindowLayout from '../layouts/WindowLayout.astro';
---
<WindowLayout
  title="Style Guide — Porter Fairbourne"
  description="Design system and style guide for porterfairbourne.com."
  windowTitle="style-guide.html"
>
  <iframe
    src="/porter_style_guide.html"
    title="Porter Fairbourne — Style Guide"
    style="display: block; width: 100%; height: 1200px; min-height: 600px; border: 0; background: var(--bg);"
    onload="try { this.style.height = (this.contentDocument.body.scrollHeight + 24) + 'px'; } catch (_) {}"
  ></iframe>
</WindowLayout>
