---
import WindowLayout from '../layouts/WindowLayout.astro';
---
<WindowLayout
  title="Notepad — Porter Fairbourne"
  description="Leave Porter a quick note. Lands in his inbox."
  windowTitle="notepad.app"
  narrow
>
  <section style="margin-bottom: var(--s-6);">
    <div class="t-label" style="margin-bottom: var(--s-3);">Notepad</div>
    <h1 class="t-h1">Leave a note<span class="accent">.</span></h1>
    <p class="t-italic-serif" style="margin-top: var(--s-4); max-width: 36ch;">
      Hiring, hellos, what you're building — anything. Lands in my inbox.
    </p>
  </section>

  <div class="notepad" id="notepad">
    <form class="notepad__form" id="notepad-form" novalidate>
      <label class="notepad__field">
        <span class="t-label">Name <span class="notepad__req" aria-hidden="true">*</span></span>
        <input type="text" name="name" required minlength="1" maxlength="80" autocomplete="name" />
      </label>

      <label class="notepad__field">
        <span class="t-label">Email <span class="notepad__opt">(optional)</span></span>
        <input type="email" name="email" maxlength="120" autocomplete="email" />
      </label>

      <label class="notepad__field">
        <span class="t-label">Message <span class="notepad__req" aria-hidden="true">*</span></span>
        <textarea name="message" required minlength="1" maxlength="2000" rows="8"></textarea>
      </label>

      {/* Honeypot — CSS-hidden, autofill-disabled, tab-skipped */}
      <div class="notepad__pot" aria-hidden="true">
        <label>Company<input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
      </div>

      <div class="notepad__row">
        <p class="notepad__error" id="notepad-error" role="alert" aria-live="polite"></p>
        <button type="submit" class="btn btn-solid" id="notepad-submit">Send note ↗</button>
      </div>
    </form>

    <div class="notepad__success" id="notepad-success" hidden aria-live="polite">
      <svg viewBox="0 0 200 80" class="notepad__handwritten" aria-hidden="true">
        <path
          d="M 8 50 q 6 -20 18 -18 t 14 18 q 0 -22 18 -22 t 16 26 q 4 -28 22 -28 t 14 24 q 6 -18 22 -16 t 18 20 q 8 -16 24 -14 t 22 14"
          fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
        />
      </svg>
      <p class="notepad__got-it">got it, talk soon — porter</p>
    </div>
  </div>

  <script is:inline>
    (function () {
      var form = document.getElementById('notepad-form');
      var submit = document.getElementById('notepad-submit');
      var errorEl = document.getElementById('notepad-error');
      var successEl = document.getElementById('notepad-success');
      var notepad = document.getElementById('notepad');
      if (!form || !submit || !errorEl || !successEl || !notepad) return;

      var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function setError(msg) { errorEl.textContent = msg || ''; }

      function showSuccess() {
        // Hide form, show success block. With motion, the form folds first.
        if (reduceMotion) {
          form.hidden = true;
          successEl.hidden = false;
          return;
        }
        form.classList.add('notepad__form--folding');
        setTimeout(function () {
          form.hidden = true;
          successEl.hidden = false;
          successEl.classList.add('notepad__success--in');
        }, 480);
      }

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        setError('');
        submit.disabled = true;
        submit.textContent = 'Sending…';

        var fd = new FormData(form);
        var payload = {
          name: String(fd.get('name') || ''),
          email: String(fd.get('email') || ''),
          message: String(fd.get('message') || ''),
          company: String(fd.get('company') || ''),
        };

        try {
          var res = await fetch('/api/notepad', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(payload),
          });
          var data = await res.json().catch(function () { return {}; });
          if (res.ok && data.ok) {
            showSuccess();
            return;
          }
          if (res.status === 429) {
            setError('Too many notes from this address today. Try again in a bit, or email me directly: pfairbourne@gmail.com');
          } else if (data.error === 'bad_name' || data.error === 'bad_message' || data.error === 'bad_email') {
            setError('Looks like one of the fields is empty or too long.');
          } else {
            setError("Couldn't deliver right now — email me at pfairbourne@gmail.com.");
          }
        } catch (_) {
          setError("Couldn't deliver right now — email me at pfairbourne@gmail.com.");
        } finally {
          submit.disabled = false;
          submit.textContent = 'Send note ↗';
        }
      });
    })();
  </script>
</WindowLayout>

<style>
  .notepad {
    background: var(--bg-elev);
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    padding: var(--s-6) var(--s-6) var(--s-5);
    background-image:
      repeating-linear-gradient(
        to bottom,
        transparent 0px,
        transparent 31px,
        var(--rule) 31px,
        var(--rule) 32px
      );
    background-position: 0 28px;
    transform-origin: top center;
  }

  .notepad__form { display: flex; flex-direction: column; gap: var(--s-4); }
  .notepad__field { display: flex; flex-direction: column; gap: 6px; }
  .notepad__field input,
  .notepad__field textarea {
    padding: 10px 12px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    background: var(--bg);
    color: var(--ink);
    font: inherit;
    transition: border-color 160ms ease;
    resize: vertical;
  }
  .notepad__field input:focus,
  .notepad__field textarea:focus {
    outline: none;
    border-color: var(--ink-2);
  }
  .notepad__req { color: var(--accent); }
  .notepad__opt { color: var(--muted); font-weight: 400; text-transform: none; letter-spacing: 0; }

  .notepad__pot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .notepad__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    margin-top: var(--s-2);
    flex-wrap: wrap;
  }
  .notepad__error {
    color: var(--accent);
    font-size: 13px;
    margin: 0;
    flex: 1 1 60%;
    min-width: 0;
  }
  #notepad-submit { cursor: pointer; }

  /* — Folding success animation — */
  .notepad__form--folding {
    animation: notepad-fold 480ms cubic-bezier(0.4, 0, 0.6, 1) forwards;
    transform-origin: top center;
    pointer-events: none;
  }
  @keyframes notepad-fold {
    0%   { transform: scaleY(1) translateY(0); opacity: 1; }
    50%  { transform: scaleY(0.35) translateY(0); opacity: 0.6; }
    100% { transform: scaleY(0) translateY(40px); opacity: 0; }
  }

  .notepad__success {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-4);
    padding: var(--s-6) 0;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 320ms ease 80ms, transform 320ms ease 80ms;
  }
  .notepad__success[hidden] { display: none; }
  .notepad__success--in { opacity: 1; transform: translateY(0); }
  .notepad__handwritten {
    width: 180px;
    height: 64px;
    color: var(--accent);
  }
  .notepad__got-it {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 22px;
    color: var(--ink);
    line-height: 1.3;
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .notepad__form--folding { animation: none; }
    .notepad__success { transition: none; transform: none; }
  }
</style>
