---
import WindowLayout from '../layouts/WindowLayout.astro';
---
<WindowLayout
  title="Résumé — Porter Fairbourne"
  description="Porter Fairbourne — co-founder at Ember, AI contractor, ex-University Growth Fund, ex-Vivint."
  windowTitle="résumé.pdf"
>
  <iframe
    class="resume-frame"
    src="/porter_fairbourne_resume.html"
    title="Porter Fairbourne — Résumé"
    style="display: block; width: 100%; height: 1100px; min-height: 600px; border: 0; background: var(--bg);"
    onload="try { this.style.height = (this.contentDocument.body.scrollHeight + 24) + 'px'; } catch (_) {}"
  ></iframe>
</WindowLayout>
